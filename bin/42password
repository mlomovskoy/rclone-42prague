#!/usr/bin/env bash
#
# 42password — store the rclone config password in this OS's secret store
# (macOS Keychain / Linux secret-tool / Windows DPAPI) and wire it in via
# RCLONE_PASSWORD_COMMAND, so rclone and 42sync stop prompting on this
# machine. Run with no arguments to see every verb this script accepts.
#
# Deliberately NOT for the shared campus machine: this moves the barrier that
# protects rclone.conf from "knows the config password" to "is logged into this
# account". See README, Known limitations, before using it there.
#
# On Windows (Git for Windows' bash) there is no CLI secret store built in, so
# this generates a small helper script, $CONFIG_PATH/rclone-password-helper.ps1,
# and a sibling $CONFIG_PATH/rclone-password.enc holding the password
# encrypted with DPAPI — Windows' own per-user-account encryption, the same
# one Credential Manager uses under the hood. It decrypts only for this
# Windows account on this machine, which is the same tradeoff as
# Keychain/secret-tool above, not a weaker one: the .enc file is useless
# copied anywhere else. Lives under this toolkit's own config directory, not
# in ~/bin, since it's a secret, not a script meant to be run by name.

set -uo pipefail

if [[ -t 1 ]]; then
  C_RED=$'\033[31m'; C_GRN=$'\033[32m'; C_YEL=$'\033[33m'; C_OFF=$'\033[0m'
else
  C_RED=""; C_GRN=""; C_YEL=""; C_OFF=""
fi

logmsg() { [[ -n "${LOG:-}" ]] || return 0; printf '%s\n' "$*" >> "$LOG" 2>/dev/null || true; }
say()    { printf '%s\n' "$*";                       logmsg "$*"; }
red()    { printf '%s%s%s\n' "$C_RED" "$*" "$C_OFF"; logmsg "$*"; }
green()  { printf '%s%s%s\n' "$C_GRN" "$*" "$C_OFF"; logmsg "$*"; }
yellow() { printf '%s%s%s\n' "$C_YEL" "$*" "$C_OFF"; logmsg "$*"; }
die()    { red "$*" >&2; logmsg "RESULT: failed"; exit 1; }

VERBS=(apply check reinstall)

print_verbs() {
  cat <<'EOF'
42password <verb>

  apply       set it up (or confirm it already is), then verify it works
  check       dry run: show what would happen, change nothing
  reinstall   re-store the password even if one is already saved (e.g. you
              changed the rclone config password) -- not the same kind of
              "force" as 42sync's force-check/force-apply: this bypasses an
              idempotency skip, not a safety guard
EOF
}

if [[ $# -eq 0 ]]; then
  print_verbs
  exit 0
fi

MODE="$1"

if [[ "$MODE" == __complete ]]; then
  printf '%s\n' "${VERBS[@]}"
  exit 0
fi

# LOG_PATH, KEEP_LOGS, BIN_PATH, and CONFIG_PATH come from here -- shared
# with every other 42* script. Sourced only now, after the no-args/__complete
# checks above: this file has a side effect (creating
# $CONFIG_PATH/42-common.local.sh if missing), and a purely informational
# query must never trigger it. Confirmed empirically: it used to.
LIBDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/42-internal/lib"
source "$LIBDIR/42-common.sh"

# RCLONE_PW_SERVICE/RCLONE_PW_OS/RCLONE_PW_WIN_HELPER/RCLONE_PW_WIN_ENCFILE,
# have(), to_winpath(), and rclone_password_stored()/rclone_password_command()
# come from here -- shared with 42sync/42projects, which use the read side
# of this (export_rclone_password_command) to compute a known-fresh
# RCLONE_PASSWORD_COMMAND themselves rather than trust an inherited one.
# This script is the only one that also writes to the store, via
# store_password() below.
source "$LIBDIR/42-password-command.sh"
[[ -n "$RCLONE_PW_OS" ]] || die "Unsupported OS: $(uname -s). This covers macOS, Linux, and
Windows via Git for Windows' bash (not native cmd/PowerShell)."

# ensure_line() -- writes RC_LINE into the shell rc below, replacing any
# OLDER RCLONE_PASSWORD_COMMAND export instead of leaving it behind
# alongside a new one (e.g. after CONFIG_PATH changes and this is re-run).
# Shared with 42sync_install.sh's PATH/completions lines -- same fix.
source "$LIBDIR/42-ensure-line.sh"

# detect_shell_rc() -- which shell rc file to write RCLONE_PASSWORD_COMMAND
# into, below. Shared with 42sync_install.sh's setup_shell(), which needs
# the exact same detection for its own PATH/completions lines.
source "$LIBDIR/42-shell-rc.sh"

DRY=0
FORCE=0
case "$MODE" in
  apply)      ;;
  check)      DRY=1 ;;
  reinstall)  FORCE=1 ;;
  *)          die "Unknown verb '$MODE'. Run '42password' with no arguments to see the list." ;;
esac

mkdir -p "$LOG_PATH"
LOG="$LOG_PATH/42password-$MODE-$(date +%Y-%m-%d-%H%M%S).log"
: > "$LOG"
ln -sfn "$LOG" "$LOG_PATH/42password-$MODE-last.log"

prune_logs() {
  local keep
  keep=$(ls -1t "$LOG_PATH"/42password-{apply,check,reinstall}-*.log 2>/dev/null)
  [[ -n "$keep" ]] || return 0
  printf '%s\n' "$keep" | tail -n +$((KEEP_LOGS+1)) | xargs -r rm --
}

on_exit() { prune_logs; printf '%sLog: %s%s\n' "$C_GRN" "$LOG" "$C_OFF"; }
trap on_exit EXIT

# Where the Windows helper and its encrypted sibling live: under $CONFIG_PATH
# (this toolkit's own config directory, from the shared lib -- honors a
# config-path override same as everything else), not ~/bin -- this is a
# secret (an encrypted password blob) and belongs with the toolkit's other
# config/secrets, not among the scripts. NOT literally "alongside
# rclone.conf": on Linux/macOS $CONFIG_PATH's parent happens to be the same
# ~/.config rclone itself uses, but on Windows rclone.conf actually lives
# under %APPDATA%\rclone, a different directory entirely -- the earlier
# version of this comment claimed otherwise, which wasn't true there. It's
# this toolkit's closest Windows equivalent of macOS Keychain or Linux
# secret-tool either way. Kept as siblings so the helper's own
# Join-Path $PSScriptRoot 'rclone-password.enc' lookup needs no separate
# path to be told where its .enc file is. Local aliases onto the shared
# lib's own copies of these paths (42-password-command.sh), not a second
# definition -- store_password() below is the one place that WRITES them,
# everything that only reads them goes through the shared lib instead.
WIN_CONFIG_DIR="$CONFIG_PATH"
WIN_HELPER="$RCLONE_PW_WIN_HELPER"
WIN_ENCFILE="$RCLONE_PW_WIN_ENCFILE"

# Same shell-rc detection as 42sync_install.sh (shared lib, so this lands in
# the file that already has the PATH entry rather than a second, easy-to-miss
# one) -- unsupported is fatal here specifically, unlike setup_shell()'s
# skip-and-continue, since there's nowhere else to put RCLONE_PASSWORD_COMMAND.
detect_shell_rc
SHELLNAME="$SHELL_NAME"
RC="$SHELL_RC"
[[ -n "$RC" ]] || die "Unsupported shell '$SHELLNAME' — add RCLONE_PASSWORD_COMMAND to your shell rc by hand."

# For writing into the shell rc. On macOS/Linux this is a literal $USER, NOT
# resolved: baking in today's username would silently break if this rc file is
# ever reused under a different account, and would also never match an
# existing hand-written line (same literal-$USER convention), causing a
# duplicate. On Windows the path is resolved the same way, but deferred: the
# unevaluated $(cygpath ...) call is what gets written to the rc file, and only
# runs when that file is later sourced -- so a copy of ~/bin under a different
# Windows profile still resolves correctly rather than pointing at this one.
#
# $CONFIG_PATH itself gets the same symbolic-vs-literal treatment
# 42sync_install.sh's setup_shell() uses for BIN_PATH: written as the
# unevaluated literal string "$HOME/.config/_projects-sync-rclone" while it's
# still the default (so it re-resolves correctly under a different account,
# or after a future HOME change), but as today's actual resolved value if a
# config-path override is in effect -- an override might not be expressible
# as a portable, re-resolvable string at all (e.g. an absolute path picked
# for this one machine on purpose).
password_command_rc() {
  local win_config_dir_rc="$WIN_CONFIG_DIR"
  [[ "$WIN_CONFIG_DIR" == "$HOME/.config/_projects-sync-rclone" ]] \
    && win_config_dir_rc='$HOME/.config/_projects-sync-rclone'
  case "$RCLONE_PW_OS" in
    osx)     printf 'security find-generic-password -a $USER -s %s -w' "$RCLONE_PW_SERVICE" ;;
    linux)   printf 'secret-tool lookup service %s username $USER' "$RCLONE_PW_SERVICE" ;;
    windows) printf 'powershell.exe -NoProfile -NonInteractive -File $(cygpath -w "%s/rclone-password-helper.ps1")' "$win_config_dir_rc" ;;
  esac
}

store_password() {
  case "$RCLONE_PW_OS" in
    osx)
      have security || die "security CLI not found — unexpected on macOS."
      local pw
      # zsh's `read -p` means "read from a coprocess", not "show this prompt" —
      # print the prompt separately rather than hit that by surprise.
      printf 'rclone config password: '
      read -r -s pw; echo
      [[ -n "$pw" ]] || die "Empty password, nothing stored."
      security add-generic-password -a "$USER" -s "$RCLONE_PW_SERVICE" -w "$pw" -U 2>>"$LOG" \
        || die "Could not store the password in Keychain. See: $LOG"
      unset pw
      ;;
    linux)
      have secret-tool || die "secret-tool not found. Install it first:
  Debian/Ubuntu:  sudo apt install libsecret-tools
  Fedora:         sudo dnf install libsecret"
      # secret-tool prompts for the value itself (hidden) — no separate read.
      secret-tool store --label="rclone config password" service "$RCLONE_PW_SERVICE" username "$USER" 2>>"$LOG" \
        || die "Could not store the password via secret-tool.
Most likely no keyring daemon is unlocked in this session (normal after a
desktop login, not guaranteed on every campus machine). See: $LOG"
      ;;
    windows)
      have powershell.exe || die "powershell.exe not found — unexpected on Windows."
      mkdir -p "$WIN_CONFIG_DIR"
      # Copied fresh from the on-disk template every run so a change to it
      # always propagates, rather than a stale copy from an earlier version
      # silently sticking around. It only ever reads its own sibling .enc file.
      cp "$WIN_DIR/rclone-password-helper.ps1" "$WIN_HELPER"
      # Deliberately no -NonInteractive here: unlike every other PowerShell
      # call in this toolkit, this one's whole job is to prompt. -NonInteractive
      # suppresses PowerShell's own interactive prompts, Read-Host included.
      powershell.exe -NoProfile -Command \
        "\$sec = Read-Host -AsSecureString -Prompt 'rclone config password'; if (\$sec.Length -eq 0) { exit 1 }; \$sec | ConvertFrom-SecureString | Set-Content -NoNewline -LiteralPath '$(to_winpath "$WIN_ENCFILE")'" \
        || die "Could not store the password via DPAPI (empty input, or Ctrl-C). See: $LOG"
      ;;
  esac
}

RC_LINE="export RCLONE_PASSWORD_COMMAND=\"$(password_command_rc)\""

logmsg "=== 42password $MODE $(date '+%F %T') os=$RCLONE_PW_OS host=$(uname -n) ==="

if (( DRY )); then
  yellow "Dry run — nothing will be changed."
  echo
fi
say "Target: $RCLONE_PW_OS, secret store service '$RCLONE_PW_SERVICE', shell rc ${RC/#$HOME/\~}"
echo

if rclone_password_stored && (( ! FORCE )); then
  green "ok         password already stored"
elif (( DRY )); then
  if (( FORCE )); then
    yellow "would re-prompt for and overwrite the stored password (reinstall)"
  else
    yellow "would prompt for and store the rclone config password"
  fi
else
  store_password
  case "$RCLONE_PW_OS" in
    osx)     store_label="Keychain" ;;
    linux)   store_label="Linux keyring" ;;
    windows) store_label="a DPAPI-encrypted file (${WIN_ENCFILE/#$HOME/\~})" ;;
  esac
  green "stored     rclone config password in $store_label"
fi

ensure_line "$RC" '^export RCLONE_PASSWORD_COMMAND=' "$RC_LINE" "RCLONE_PASSWORD_COMMAND"

echo
if (( DRY )); then
  yellow "Dry run — nothing was changed."
  logmsg "RESULT: dry run only"
  exit 0
fi

# Verify end-to-end with a real, harmless rclone call — in-process, so it does
# not depend on this shell (or a new one) having re-read the rc file yet.
say "Verifying: rclone listremotes using the new password command ..."
if RCLONE_PASSWORD_COMMAND="$(rclone_password_command)" rclone listremotes >/dev/null 2>>"$LOG"; then
  green "Verified — rclone decrypts the config with no prompt."
else
  red "rclone still could not decrypt the config non-interactively."
  say "The stored password may not match rclone.conf's actual password. See: $LOG"
  exit 1
fi

echo
green "Done. Open a new shell (or: exec ${SHELL##*/}) to pick this up everywhere."
logmsg "RESULT: ok"
