#!/usr/bin/env bash
#
# 42sync — two-way sync of ~/Projects with gdrive:_projects-sync-rclone via rclone bisync.
# Run with no arguments to see every verb this script accepts.
#
# Project selection (what syncs to THIS machine) lives in: 42projects
# Log listing (across every 42* script) lives in: 42logs

set -uo pipefail

# Every verb this script accepts, in the order shown by print_verbs -- also
# the single source of truth for mode validation and for `__complete` (bash
# tab-completion reads this via `42sync __complete`, see 42-completions.bash).
VERBS=(
  apply check
  dirty-apply dirty-check
  verify
  force-check force-apply
  orphans-check orphans-apply
  onboard-check onboard-apply
  reconstitute
  resync-check resync-apply
  seed status
  configure-set configure-reset configure-show
)

print_verbs() {
  cat <<'EOF'
42sync <verb>

  apply                  real two-way sync, skipping any repo with uncommitted changes
  check                  dry run of apply -- shows what would happen, changes nothing

  dirty-apply [DIRTY]    like apply, but includes dirty repos too. DANGEROUS for a repo
                         whose .git has genuinely diverged from Drive -- see
                         TROUBLESHOOTING.md, "A repo's .git got corrupted by a bisync
                         conflict". Only for grabbing a same-machine backup of an
                         in-progress edit, never as a routine habit.
  dirty-check            dry run of dirty-apply

  verify                 compare real content: is everything local actually on Drive?

  force-check            preview pushing a rename/reorg through the delete guard
  force-apply [FORCE]    apply it for real

  orphans-check          list excluded files stranded on Drive; deletes nothing
  orphans-apply [DELETE] delete them for real

  onboard-check           preview which repos need a GitHub repo of their own
  onboard-apply [ONBOARD] create them for real: new private repo, remote, one push, marker

  reconstitute           list repos with a marker but no local .git, and the clone
                         command to fix each -- never clones automatically

  resync-check           preview the first sync when both sides already have content
  resync-apply [RESYNC]  apply it for real

  seed                   ~/Projects is empty: pull from Drive, then set the baseline
  status                 local size, remote size, recent runs

  configure-set <name> <value>  set a per-machine override, e.g.:
                                   42sync configure-set keep-logs 50
  configure-reset <name>         revert that override to its default
  configure-show                 print the current effective value of every setting

[WORD] arguments are optional: give them to apply non-interactively (for
scripting), omit them to get the usual dry-run-then-typed-prompt flow.

Project selection (what syncs to THIS machine): 42projects
Log listing (across every 42* script):          42logs
EOF
}

# Checked first, before any side effect below (creating state dirs, default
# filter files, etc.) -- both this and `__complete` must produce ONLY their
# own output on stdout. `__complete` in particular is parsed verbatim by
# bash's completion function (42-completions.bash); anything else printed
# before it runs -- e.g. the old "Created filter file: ..." notice used to
# fire here on a brand-new machine's very first TAB press -- would leak into
# the candidate list.
if [[ $# -eq 0 ]]; then
  print_verbs
  exit 0
fi

MODE="$1"

# Hidden, not for humans -- bash tab-completion calls this (see
# 42-completions.bash).
if [[ "$MODE" == __complete ]]; then
  printf '%s\n' "${VERBS[@]}"
  exit 0
fi

# LOCAL_PATH, REMOTE_PATH, FILE_FILTERS, PROJECT_FILTERS, LOG_PATH, WORK_PATH, KEEP_LOGS,
# BIN_PATH all come from here -- shared with every other 42* script, see
# that file for what each one means and why PROJECT_FILTERS is deliberately
# separate from FILE_FILTERS.
LIBDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/42-internal/lib"
source "$LIBDIR/42-common.sh"

# configure_set/configure_reset/configure_show -- the configure-* verbs below
# just call these. See that file for what they touch and why.
source "$LIBDIR/42-configure.sh"

# classify_remotes()/github_owner() -- onboard-check/onboard-apply below use
# these to decide which repos need a GitHub repo of their own and to check
# ownership. No other verb uses this file yet.
source "$LIBDIR/42-remote-classify.sh"

# Computes RCLONE_PASSWORD_COMMAND fresh, from the CURRENT $CONFIG_PATH, and
# exports it here -- rather than every rclone call below trusting whatever
# value this script happened to inherit from the shell that launched it,
# which can go stale the moment CONFIG_PATH changes or the secret moves (see
# TROUBLESHOOTING.md). A no-op if 42password was never set up on this
# machine. Shared with 42projects and 42password itself.
source "$LIBDIR/42-password-command.sh"
export_rclone_password_command

mkdir -p "$LOG_PATH" "$WORK_PATH" "$(dirname "$FILE_FILTERS")"

[[ -f "$FILE_FILTERS" ]] || {
  cp "$DEFAULTS_DIR/filters/projects-filters.txt" "$FILE_FILTERS"
  echo "Created filter file: $FILE_FILTERS"
}
[[ -f "$PROJECT_FILTERS" ]] || cp "$DEFAULTS_DIR/filters/projects-local.txt" "$PROJECT_FILTERS"

# A repo that has this marker at its root (written by onboard-apply) is
# "onboarded" -- has a GitHub remote of its own, so its .git/** no longer
# needs to ride along through bisync whole. Referenced here (for the
# exclusion below) and by write_marker() further down.
MARKER_FILENAME=".42sync-remote"

# Every onboarded repo's .git/** gets excluded from bisync, computed fresh
# from which repos currently have $MARKER_FILENAME rather than persisted
# into $FILE_FILTERS -- so this can never go stale independently of the
# markers themselves, and never needs its own "regenerate on onboarding"
# step. A repo with no marker yet keeps syncing .git/ the old way.
GIT_EXCLUDE_PATTERNS=()
while IFS= read -r -d '' marker; do
  onboarded_repo="$(dirname "$marker")"
  GIT_EXCLUDE_PATTERNS+=("/${onboarded_repo#$LOCAL_PATH/}/.git/**")
done < <(find -H "$LOCAL_PATH" -type f -name "$MARKER_FILENAME" -print0 2>/dev/null)

# .git/info/exclude and .env.example both need a carve-out from a broader
# exclude elsewhere (the per-repo .git/** exclude below for the first, the
# plain .env/.env.* excludes in $FILE_FILTERS for the second) -- but a bare,
# unanchored "+" rule for either (the shape ADR-0004 originally shipped,
# and reverted, for .git/info/exclude) makes rclone auto-generate a
# directory rule allowing descent into EVERY directory, confirmed via
# `rclone --dump filters` -- checked before $PROJECT_FILTERS's own
# project-selection catch-all, leaking the target file out of a project
# excluded from this machine entirely. See
# design/adr/0004-git-info-exclude-carveout.md and
# design/open-questions.md #15 for the full incident (found for
# .git/info/exclude, confirmed to affect .env.example the same way).
#
# Fixed by scoping the carve-out to each CURRENTLY INCLUDED project by
# name (e.g. "+ /rclone-42prague/**/.git/info/exclude") instead of a bare
# pattern -- confirmed via --dump filters that an anchored pattern like
# this produces directory-allow rules scoped to just that project's own
# prefix, not "allow descend into anything." Computed fresh every run from
# $PROJECT_FILTERS's own "+" lines (same "recompute derived state" pattern
# GIT_EXCLUDE_PATTERNS above already uses) -- a project excluded from this
# machine gets no pattern at all, so it has nothing to leak through, and an
# included project never needs a line added or removed by hand.
#
# Two patterns per project per target, not one: "**/ " requires at least
# one real directory component before it (the same gotcha $FILE_FILTERS's
# own header warns about for single-segment globs) -- a project that IS
# itself a repo (rclone-42prague/.git/info/exclude, no nesting) needs the
# un-wildcarded form; a project containing nested repos (42Prague's own
# repos/*/.git/info/exclude) needs the "**/ " form. Confirmed both are
# needed against real fixtures at both nesting depths.
CARVEOUT_TARGETS=(".git/info/exclude" ".env.example")
CARVEOUT_PATTERNS=()
while IFS= read -r project; do
  [[ -n "$project" ]] || continue
  for target in "${CARVEOUT_TARGETS[@]}"; do
    CARVEOUT_PATTERNS+=("/${project}/${target}")
    CARVEOUT_PATTERNS+=("/${project}/**/${target}")
  done
done < <(sed -nE 's#^\+ /([^/]+)/\*\*$#\1#p' "$PROJECT_FILTERS" 2>/dev/null)

# Both filter files, in one place, for every command that must see what this
# machine actually syncs. NOT used by 'orphans-*' -- see the note on PROJECT_FILTERS.
FILTER_ARGS=()

# Must be FIRST on the command line: confirmed with rclone's own --dump
# filters that a bare --exclude/--filter flag is always spliced in BEFORE
# any --filter-from's rules regardless of where it sits, but multiple
# --filter-from flags DO combine in command-line order -- so being first
# here is what lets these carve-outs actually override $FILE_FILTERS's own
# .env excludes and the per-repo .git/** exclude below, both of which they
# need to win against.
CARVEOUT_FILE=""
if (( ${#CARVEOUT_PATTERNS[@]} )); then
  CARVEOUT_FILE="$(mktemp)"
  printf -- '+ %s\n' "${CARVEOUT_PATTERNS[@]}" > "$CARVEOUT_FILE"
  FILTER_ARGS+=(--filter-from "$CARVEOUT_FILE")
fi

FILTER_ARGS+=(--filter-from "$FILE_FILTERS")
if grep -qE '^- ' "$PROJECT_FILTERS" 2>/dev/null; then
  FILTER_ARGS+=(--filter-from "$PROJECT_FILTERS")
fi

# Also a SEPARATE --filter-from positioned last, for the same reason the
# carve-out file above must be first: command-line order among multiple
# --filter-from flags is what's respected, and this one needs to be checked
# AFTER the carve-out file's own .git/info/exclude rule, not before it.
GIT_EXCLUDE_FILE=""
if (( ${#GIT_EXCLUDE_PATTERNS[@]} )); then
  GIT_EXCLUDE_FILE="$(mktemp)"
  printf -- '- %s\n' "${GIT_EXCLUDE_PATTERNS[@]}" > "$GIT_EXCLUDE_FILE"
  FILTER_ARGS+=(--filter-from "$GIT_EXCLUDE_FILE")
fi

# --check-access  refuses to run unless RCLONE_TEST markers exist on BOTH sides.
# --max-delete    aborts if >25% of files would vanish ('force-apply' bypasses this).
# --links         stores symlinks as .rclonelink files instead of skipping them.
COMMON=(
  --workdir "$WORK_PATH"
  "${FILTER_ARGS[@]}"
  --check-access
  --max-delete 25
  --links
  --verbose
)

red()    { printf '\033[31m%s\033[0m\n' "$*"; }
green()  { printf '\033[32m%s\033[0m\n' "$*"; }
yellow() { printf '\033[33m%s\033[0m\n' "$*"; }
die()    { red "$*" >&2; exit 1; }

# Terminal output is not otherwise logged — rclone's is, via tee. Used by the
# destructive paths to record the decision, so a log answers "did this actually
# delete anything?" without needing to have watched it happen.
logmsg() { [[ -n "${LOG:-}" ]] || return 0; printf '%s\n' "$*" >> "$LOG" 2>/dev/null || true; }

# Validate before building a log name, so a typo does not leave a stray
# bogus-<timestamp>.log behind.
valid=0
for v in "${VERBS[@]}"; do [[ "$MODE" == "$v" ]] && valid=1 && break; done
(( valid )) || die "Unknown verb '$MODE'. Run '42sync' with no arguments to see the list."

# Every run gets its own log, whatever the mode and however it ends. Created
# here rather than per-branch so the file always exists and the path printed on
# exit always points at something. Prefixed with the script's own name so logs
# stay identifiable even though the verb itself (e.g. "apply") is shared with
# other scripts in the same $LOG_PATH.
LOG="$LOG_PATH/42sync-$MODE-$(date +%Y-%m-%d-%H%M%S).log"
: > "$LOG"
ln -sfn "$LOG" "$LOG_PATH/42sync-$MODE-last.log"
logmsg "=== 42sync $MODE $(date '+%F %T') host=$(uname -n) ==="

# Printed on EVERY exit path — success, failure, abort — so you never have to
# wonder where the evidence went. A trap rather than a line in each branch:
# there are many ways out of this script and they were not all covering it.
# Rotation happens here too: every mode that writes a log also rotates, including
# the ones that run no rclone at all, so pruning cannot live in the sync paths only.
on_exit() {
  [[ -n "$GIT_EXCLUDE_FILE" && -f "$GIT_EXCLUDE_FILE" ]] && rm -f "$GIT_EXCLUDE_FILE"
  [[ -n "$CARVEOUT_FILE" && -f "$CARVEOUT_FILE" ]] && rm -f "$CARVEOUT_FILE"
  prune_logs
  printf '\033[32mLog: %s\033[0m\n' "$LOG"
}
trap on_exit EXIT

# Prunes this script's logs only, by verb, keeping the newest KEEP_LOGS across
# all of them combined. 42links/42password/42sync_install.sh/42projects share
# $LOG_PATH and prune their own, so no script deletes another's evidence. Every
# verb is its own exact brace entry (not a shared stem like "force-*") so
# force-check and force-apply logs can never double-match each other's glob.
prune_logs() {
  local keep
  keep=$(ls -1t "$LOG_PATH"/42sync-{apply,check,dirty-apply,dirty-check,verify,force-check,force-apply,orphans-check,orphans-apply,onboard-check,onboard-apply,reconstitute,resync-check,resync-apply,seed,status}-*.log 2>/dev/null)
  [[ -n "$keep" ]] || return 0
  printf '%s\n' "$keep" | tail -n +$((KEEP_LOGS+1)) | xargs -r rm --
}

# Long runs die with the terminal. Say so before, not after.
warn_no_multiplexer() {
  [[ -n "${TMUX:-}${STY:-}" ]] && return 0
  yellow "Not running inside tmux or screen."
  echo   "A large sync can take many minutes; closing this terminal kills it mid-run."
  echo   "Safer:  tmux new -s sync   then re-run this command inside it."
  echo
  read -r -p "Continue anyway? [y/N] " a || true
  [[ "$a" == [yY] ]] || die "Aborted."
}

# Drops the warning notice into $LOCAL_PATH if this is the first machine ever to
# reach this point -- see bin/42-internal/defaults/READ-ME-FIRST.{txt,md} for why there
# are two copies (one plain-text, one Markdown, so it reads cleanly whether
# opened from Drive's web UI, a mounted Drive folder, or a local editor).
seed_readme_first() {
  local ext
  for ext in txt md; do
    [[ -f "$LOCAL_PATH/READ-ME-FIRST.$ext" ]] || cp "$DEFAULTS_DIR/READ-ME-FIRST.$ext" "$LOCAL_PATH/READ-ME-FIRST.$ext"
  done
}

require_local() {
  [[ -d "$LOCAL_PATH" ]] || die "$LOCAL_PATH does not exist.
On a campus seat your home follows you, so this is unexpected — check you are the
right user before assuming a fresh start. If it really is empty: 42sync seed"
  [[ -f "$LOCAL_PATH/RCLONE_TEST" ]] || die "Access marker missing from $LOCAL_PATH.
This usually means the local folder was wiped or is not the synced one.
Refusing to sync — inspect it first. Only run '42sync seed' if ~/Projects is
genuinely empty and you accept Drive as the source of truth."
}

# Drive is a mirror, and a mirror has no history. Two things are worth seeing before a
# run: work not committed at all, and commits that exist only on this machine. The
# second is the one that bites — vogsphere revokes write access once a project has been
# evaluated, so "just push it" is not always available. See README, Known limitations.
#
# Also fills the global DIRTY_REPOS array with each dirty repo's path relative
# to $LOCAL_PATH. 'apply'/'check' use this to skip just those repos rather than
# either silently carrying an uncommitted edit along via bisync, or aborting
# the whole sync over a single repo someone happens to be mid-edit on.
DIRTY_REPOS=()
check_repos() {
  DIRTY_REPOS=()
  # -H: follow a symlink/junction given as the search ROOT (needed when $LOCAL_PATH
  # itself is a junction, e.g. remapped to a different drive on Windows), but
  # do NOT follow symlinks found deeper in the tree (a plain -L would) --
  # those can be real repo content (a Piscine exercise's symlink test
  # fixture), and following them risks loops or double-scanning. Found by
  # $LOCAL_PATH's junction silently returning zero .git dirs on one run and
  # working normally on others -- an MSYS/NTFS reparse-point quirk, not
  # anything this script's logic controls, so -H makes it robust regardless.
  local repo dirty ahead rel
  while IFS= read -r -d '' gitdir; do
    repo="$(dirname "$gitdir")"
    rel="${repo#$LOCAL_PATH/}"
    dirty="$(git -C "$repo" status --porcelain 2>/dev/null)"
    ahead="$(git -C "$repo" log --oneline '@{u}..HEAD' 2>/dev/null)"
    if [[ -n "$dirty" ]]; then
      yellow "uncommitted changes: $rel"
      DIRTY_REPOS+=("$rel")
    fi
    [[ -n "$ahead" ]] && yellow "unpushed commits ($(printf '%s\n' "$ahead" | wc -l)): $rel"
  done < <(find -H "$LOCAL_PATH" -type d -name .git -print0 2>/dev/null)
}

# Builds SKIP_ARGS from DIRTY_REPOS -- a transient, this-run-only exclude, not
# written to $FILE_FILTERS or $PROJECT_FILTERS. Shared by 'apply' and 'check' so the
# preview and the real thing always compute the exact same skip set.
SKIP_ARGS=()
compute_skip_args() {
  SKIP_ARGS=()
  local rel
  for rel in "${DIRTY_REPOS[@]}"; do
    SKIP_ARGS+=(--exclude "/$rel/**")
  done
}

# Which repos need a GitHub repo of their own. Walks the same way
# check_repos() does (same -H reasoning: a junction/symlink LOCAL_PATH root
# needs following, deeper ones don't). Fills ONBOARD_CANDIDATES (repo paths
# relative to $LOCAL_PATH that have >=1 remote already, but none owned by
# the user on github.com, reusing classify_remotes() rather than
# re-deriving that check), ONBOARD_MARKER_ONLY (a repo that already has an
# owned github.com remote -- rclone-42prague itself is exactly this case,
# found the hard way when its own .git suffered a real bisync conflict
# specifically because it had never gotten a marker -- but has no
# .42sync-remote marker yet, so it still needs one written to enable the
# .git/** exclusion; no new repo to create, no push needed), and
# ONBOARD_SKIPPED_BROKEN (a `.git` that exists but isn't a valid repo -- a
# real example was found auditing this on a real machine; skipped rather
# than crashing on it).
#
# Deliberately does NOT cross-reference $PROJECT_FILTERS to skip
# already-excluded projects -- the exact same known, accepted gap
# check_repos() already has, inherited here rather than fixed as a side
# effect of unrelated work.
ONBOARD_CANDIDATES=()
ONBOARD_MARKER_ONLY=()
ONBOARD_SKIPPED_BROKEN=()
scan_onboard_candidates() {
  ONBOARD_CANDIDATES=(); ONBOARD_MARKER_ONLY=(); ONBOARD_SKIPPED_BROKEN=()
  local repo rel
  while IFS= read -r -d '' gitdir; do
    repo="$(dirname "$gitdir")"
    rel="${repo#$LOCAL_PATH/}"
    if ! git -C "$repo" rev-parse --git-dir >/dev/null 2>&1; then
      ONBOARD_SKIPPED_BROKEN+=("$rel")
      continue
    fi
    classify_remotes "$repo"
    (( ${#REMOTE_NAMES[@]} == 0 )) && continue  # Scenario A: no remotes, left alone
    if (( ${#REMOTE_PUSH[@]} > 0 )); then
      [[ -f "$repo/$MARKER_FILENAME" ]] || ONBOARD_MARKER_ONLY+=("$rel")
      continue
    fi
    ONBOARD_CANDIDATES+=("$rel")
  done < <(find -H "$LOCAL_PATH" -type d -name .git -print0 2>/dev/null)
}

# Path-derived repo name for `gh repo create`, joining every relative path
# segment from $LOCAL_PATH -- chosen deliberately over a shorter "immediate
# parent + basename" alternative: 42's Piscine exercises reuse names like
# "ex00" across different cohorts, a real collision already visible in this
# machine's own 42Prague/repos/ layout. Not PROVABLY collision-free -- "-"
# is both the segment separator and a character GitHub allows within a
# segment, so two sufficiently contrived distinct paths could still collapse
# to the same name -- but collision-resistant in every real case checked,
# and `gh repo create` failing on a genuine name clash already fails loudly
# and skips just that repo rather than corrupting anything.
repo_onboard_name() {  # repo-relative-path, e.g. 42Prague/repos/-1_PiscineReloaded
  local rel="$1" name
  name="${rel//\//-}"
  # GitHub repo names allow only [A-Za-z0-9._-]; replace anything else with
  # "-" rather than reject the whole name over one unexpected character.
  name="${name//[^A-Za-z0-9._-]/-}"
  # Collapse runs of "-" left by the substitutions above -- this machine's
  # own folder names (e.g. "-1_PiscineReloaded", "-2_PiscineMay26") start
  # with "-" themselves, which doubles up right at the path-join point.
  # Trades a little collision-resistance for a much more readable name (see
  # the function-level note above); a real clash still fails safely.
  while [[ "$name" == *--* ]]; do name="${name//--/-}"; done
  name="${name#-}"; name="${name%-}"
  printf '%s\n' "${name:0:100}"  # GitHub's own repo-name length limit
}

# A plain-text, regenerable record of every remote a repo has, so a machine
# that receives this repo's working-tree files via Drive with no local .git
# of its own could reconstitute one via `git clone` instead of ending up
# with an orphaned pile of files. That reconstitution (consuming this
# marker on the receiving end) isn't implemented yet -- written here only as
# onboarding's own side effect, not regenerated on every regular sync.
# $MARKER_FILENAME itself is set near the top of this script, alongside
# FILTER_ARGS, since the per-repo .git/** exclusion below also needs it.
write_marker() {  # repo-path
  local repo="$1" name url
  {
    while IFS= read -r name; do
      [[ -n "$name" ]] || continue
      url="$(git -C "$repo" remote get-url "$name" 2>/dev/null)" || continue
      printf '%s\t%s\n' "$name" "$url"
    done < <(git -C "$repo" remote 2>/dev/null)
  } > "$repo/$MARKER_FILENAME"
}

# True if any GIT_EXCLUDE_PATTERNS repo path appears in this run's bisync
# output -- i.e. the deletes the guard tripped on actually correlate with a
# repo whose .git/** just started being excluded, not just "some repo
# somewhere is onboarded." Used by run_bisync's delete-guard diagnosis
# below to avoid a generic, possibly-wrong guess.
git_exclude_repo_in_log() {  # this-run-log-text
  local p prefix
  for p in "${GIT_EXCLUDE_PATTERNS[@]}"; do
    prefix="${p#/}"; prefix="${prefix%/.git/**}"
    grep -qF "$prefix/.git/" <<<"$1" && return 0
  done
  return 1
}

# Run bisync, keep the log, and translate rclone's cryptic failures.
run_bisync() {
  # Where this run's output starts. force-apply calls run_bisync twice into the
  # same log when the confirmation word is omitted (dry run, then real), so
  # diagnosing against the whole file would match the dry run's message and
  # report the wrong cause for the real run's failure.
  local start=0
  [[ -f "$LOG" ]] && start=$(wc -c < "$LOG")
  rclone bisync "$LOCAL_PATH" "$REMOTE_PATH" "$@" 2>&1 | tee -a "$LOG"
  local rc=${PIPESTATUS[0]}
  if (( rc != 0 )); then
    local this_run
    this_run="$(tail -c "+$((start + 1))" "$LOG" 2>/dev/null)"
    echo
    if grep -q 'cannot find prior Path1 or Path2 listings' <<<"$this_run"; then
      red "No baseline exists for this path pair yet."
      cat <<EOF

bisync needs a starting point before it can tell changes from differences.
That happens when:
  - this is the first run on this machine, or
  - either path was renamed (the cache is keyed to exact paths), or
  - a previous run was interrupted before it wrote its listings.

  ~/Projects empty, Drive is truth    ->  42sync seed
  Both sides already have content     ->  42sync resync-check, then resync-apply

Do not reach for --resync by hand: it copies each side's unique-or-newer file
to the other, which resurrects anything you deleted or renamed if the two
sides genuinely diverged rather than just never having met before.
EOF
    elif grep -q 'too many deletes' <<<"$this_run"; then
      # SKIP_ARGS is only ever non-empty here if THIS call came from 'apply'/
      # 'check' excluding a dirty repo -- in that case the "deletes" bisync
      # sees are the whole excluded repo (its .git internals included)
      # vanishing from view at once, not a real rename. force doesn't fix
      # this (it doesn't even hit this guard, since it never applies the
      # skip in the first place) -- dirty-apply does, by not excluding
      # anything.
      if (( ${#SKIP_ARGS[@]} )); then
        red "Delete guard tripped -- likely the dirty-repo skip, not a rename."
        cat <<EOF

Excluding ${#DIRTY_REPOS[@]} dirty repo(s) this run made that much of the tree --
their files, .git internals included -- disappear from view all at once. That
reads exactly like a mass deletion to the guard, even though nothing was
actually deleted; it's just this run's transient skip working as designed.

  Sync everything, dirty repos included:  42sync dirty-check   (then dirty-apply)
  Or commit the dirty repo(s) first, then a plain 'apply' needs no skip at all.

force-check/force-apply will NOT help here -- that overrides the guard for a
genuine rename, which this is not.
EOF
      elif git_exclude_repo_in_log "$this_run"; then
        red "Delete guard tripped -- likely a repo's .git/** being excluded for the first time."
        cat <<EOF

A repo just onboarded (or one whose .git/ was already excluded, but Drive
still has old objects from before it was) makes bisync's baseline see a
big batch of .git/objects/* paths vanish at once -- that reads exactly like
a mass deletion, even though it is really this one-time transition working
as designed.

  Push the one-time exclusion through:  42sync force-check   (then force-apply)

If nothing was recently onboarded, treat this as a genuine "too many
deletes" instead -- check what actually moved or was removed before
forcing anything through.
EOF
      else
        red "Delete guard tripped."
        cat <<EOF

More than 25% of files would be removed. Usually this means you renamed or moved
directories — bisync compares by path, so a rename reads as mass deletion plus
mass creation.

Check the log, then:  42sync force-check   (then force-apply once it looks right)
EOF
      fi
    elif grep -q 'Access test failed' <<<"$this_run"; then
      red "Access check failed — the RCLONE_TEST marker is missing on one side."
      echo
      echo "This guard exists to stop an empty local folder from wiping Drive."
      echo "Find out why it is gone before working around it."
    fi
    echo
    red "Failed."
    exit "$rc"
  fi
}

case "$MODE" in

  seed)
    warn_no_multiplexer
    echo "Seeding $LOCAL_PATH from $REMOTE_PATH ..."
    mkdir -p "$LOCAL_PATH"
    if [[ -n "$(ls -A "$LOCAL_PATH" 2>/dev/null)" ]]; then
      die "$LOCAL_PATH is not empty. 'seed' only runs against an empty folder.
Run '42sync check' first to see what a normal sync would do."
    fi
    rclone copy "$REMOTE_PATH" "$LOCAL_PATH" "${FILTER_ARGS[@]}" --links --verbose 2>&1 | tee -a "$LOG"
    # Stop here on a partial pull. Taking a baseline over a half-copied tree records
    # the missing files as "deleted locally", and the next sync removes them on Drive.
    (( PIPESTATUS[0] == 0 )) || die "Pull from $REMOTE_PATH failed.
Nothing was seeded. Fix the error above and run '42sync seed' again."
    touch "$LOCAL_PATH/RCLONE_TEST"
    # Only present on Drive already if some earlier machine's seed/resync put it
    # there -- the very first machine ever to bootstrap has to create it, so the
    # next 'apply' pushes it up and every later machine just pulls it down normally.
    seed_readme_first
    rclone copy "$LOCAL_PATH/RCLONE_TEST" "$REMOTE_PATH" >/dev/null
    run_bisync "${COMMON[@]}" --resync
    green "Seeded. From now on just run: 42sync apply"
    ;;

  # For the other bootstrap case 'seed' does not cover: ~/Projects already has
  # real content (so 'seed' refuses), and no baseline exists yet for this exact
  # path pair (so plain bisync refuses too, with "cannot find prior listings").
  # resync-check/resync-apply are that command, split like everything else.
  resync-check|resync-apply)
    mkdir -p "$LOCAL_PATH"
    if [[ -z "$(ls -A "$LOCAL_PATH" 2>/dev/null)" ]]; then
      die "$LOCAL_PATH is empty — that is what 'seed' is for, not resync:
  42sync seed"
    fi
    # 'seed' creates these as part of pulling from an empty folder. Here neither
    # side is necessarily empty, so create them directly if this machine is new.
    [[ -f "$LOCAL_PATH/RCLONE_TEST" ]] || touch "$LOCAL_PATH/RCLONE_TEST"
    seed_readme_first
    check_repos
    yellow "RESYNC MODE"
    cat <<'EOF'
Use this once, the first time this machine syncs against a Drive folder that
already has real content on one or both sides. 'seed' refused because
~/Projects is not empty; a plain sync refused because no baseline exists yet
for this exact path pair.

--resync copies each side's unique-or-newer file to the other side. It never
deletes anything. Where the same path exists on both sides and differs, the
newer modtime wins — check the dry run for anything you would NOT want
overwritten that way.

After this, every future sync is just: 42sync apply
EOF
    # Same reasoning as force-check/force-apply above: resync does not apply
    # the dirty-repo skip either, so say so loudly rather than let uncommitted
    # content go to Drive as a silent side effect. See open-questions.md #12.
    if (( ${#DIRTY_REPOS[@]} )); then
      echo
      red "These ${#DIRTY_REPOS[@]} repo(s) are dirty, and RESYNC does not skip them the way"
      red "plain apply does -- their uncommitted content will be synced too:"
      printf '  %s\n' "${DIRTY_REPOS[@]}"
      echo "Commit first if that is not what you want, or proceed knowingly."
    fi
    echo

    if [[ "$MODE" == resync-check ]]; then
      warn_no_multiplexer
      run_bisync "${COMMON[@]}" --resync --dry-run
      green "Dry run only — nothing was changed. Run 'resync-apply' once it looks right."
    else
      warn_no_multiplexer
      if [[ -n "${2:-}" ]]; then
        [[ "$2" == "RESYNC" ]] || die "Expected RESYNC as the confirmation argument, got '$2'."
      else
        read -r -p "Press Enter to see the dry run (Ctrl-C to abort) " _ || true
        run_bisync "${COMMON[@]}" --resync --dry-run
        echo
        yellow "Above is what WOULD happen. Nothing has changed yet."
        read -r -p "Type RESYNC to apply it for real: " reply || true
        [[ "$reply" == "RESYNC" ]] || die "Aborted — nothing was changed."
      fi
      run_bisync "${COMMON[@]}" --resync
      green "Resynced. From now on just run: 42sync apply"
    fi
    ;;

  check)
    require_local
    check_repos
    if (( ${#DIRTY_REPOS[@]} )); then
      yellow "Would skip ${#DIRTY_REPOS[@]} repo(s) with uncommitted changes (same as apply):"
      printf '  %s\n' "${DIRTY_REPOS[@]}"
      compute_skip_args
      run_bisync "${COMMON[@]}" "${SKIP_ARGS[@]}" --dry-run
    else
      run_bisync "${COMMON[@]}" --dry-run
    fi
    green "Dry run only — nothing was changed."
    ;;

  # 'check' asks bisync what it would do, which it answers from its baseline.
  # 'verify' ignores the baseline and compares actual content, so it can catch
  # the case a baseline cannot: both sides agreeing on a record that is wrong.
  # Deliberately does not reuse COMMON — --workdir, --check-access and
  # --max-delete are bisync flags, and `rclone check` rejects them.
  verify)
    require_local
    yellow "Verifying that every local file exists on Drive ..."
    cat <<'EOF'
This reads both sides in full, so it takes a while. It is read-only — safe to
interrupt, and safe to run while you are doing something else.

--one-way: files that exist only on Drive are not reported. Excluded files (see
the filter file) are invisible to it on both sides, in both directions.
EOF
    echo
    miss="$(mktemp)"
    rclone check "$LOCAL_PATH" "$REMOTE_PATH" \
      "${FILTER_ARGS[@]}" \
      --links \
      --one-way \
      --missing-on-dst "$miss" \
      --verbose 2>&1 | tee -a "$LOG"
    rc=${PIPESTATUS[0]}
    if (( rc == 0 )); then
      rm -f "$miss"
      green "Verified — every local file is on Drive, with matching content."
    else
      echo
      red "Verification FAILED — local files are missing from Drive, or differ."
      if [[ -s "$miss" ]]; then
        n=$(wc -l < "$miss")
        echo
        yellow "$n file(s) missing on Drive:"
        head -20 "$miss" | sed 's/^/  /'
        if (( n > 20 )); then echo "  ... and $((n - 20)) more — full list in the log"; fi
        { echo "--- missing on Drive ---"; cat "$miss"; } >> "$LOG"
      fi
      rm -f "$miss"
      cat <<EOF

Most often this just means you have edited something since the last sync:

  42sync check     see what it would send
  42sync apply     send it
  42sync verify    confirm it landed

If '42sync check' reports "No changes found" while this still fails, then the
baseline agrees with neither side and is the thing that is wrong. Read the
--resync warning in TROUBLESHOOTING.md before reaching for it.
EOF
      exit "$rc"
    fi
    ;;

  force-check|force-apply)
    require_local
    check_repos
    yellow "FORCE MODE"
    cat <<'EOF'
Use this only when bisync aborted with "too many deletes" because YOU renamed or
moved directories. bisync compares by path, so a rename looks like mass deletion
plus mass creation — the guard is doing its job, and force tells it to proceed.

Do NOT use this if the deletions surprise you. Investigate instead.

Check that every "File was deleted" line is an OLD path you renamed, and every
"File is new" line is its replacement.
EOF
    # Deliberately NOT the same transient skip 'apply'/'check' use: force exists
    # to push a real rename through even if the renamed repo happens to be
    # dirty, and excluding it here would silently defeat that. Loud instead of
    # silent -- found via real-data testing: an uncommitted rename went to
    # Drive silently before this warning existed.
    if (( ${#DIRTY_REPOS[@]} )); then
      echo
      red "These ${#DIRTY_REPOS[@]} repo(s) are dirty, and FORCE does not skip them the way"
      red "plain apply does -- their uncommitted content will be synced too:"
      printf '  %s\n' "${DIRTY_REPOS[@]}"
      echo "Commit first if that is not what you want, or proceed knowingly."
    fi
    echo

    if [[ "$MODE" == force-check ]]; then
      run_bisync "${COMMON[@]}" --force --dry-run
      green "Dry run only — nothing was changed. Run 'force-apply' once it looks right."
    else
      warn_no_multiplexer
      if [[ -n "${2:-}" ]]; then
        [[ "$2" == "FORCE" ]] || die "Expected FORCE as the confirmation argument, got '$2'."
      else
        read -r -p "Press Enter to see the dry run (Ctrl-C to abort) " _ || true
        run_bisync "${COMMON[@]}" --force --dry-run
        echo
        yellow "Above is what WOULD happen. Nothing has changed yet."
        read -r -p "Type FORCE to apply it for real: " reply || true
        [[ "$reply" == "FORCE" ]] || die "Aborted — nothing was changed."
      fi
      run_bisync "${COMMON[@]}" --force
      green "Forced sync complete. Normal 'apply' works again from here."
    fi
    ;;

  # An excluded file is invisible to sync in BOTH directions, so anything on Drive
  # matching an exclude was uploaded before that rule existed and no future run can
  # ever transfer or remove it. Only reachable by dropping --filter-from and naming
  # the same patterns as --include instead. Deliberately not part of any sync: this
  # deletes, and it should never happen as a side effect of something else.
  orphans-check|orphans-apply)
    mapfile -t EXCL < <(grep -E '^- ' "$FILE_FILTERS" | sed 's/^- //')
    # Also the per-repo .git/** patterns computed near the top of this
    # script -- without these, a repo's now-excluded .git/objects/* (synced
    # whole before it was onboarded) would be invisible to this cleanup too,
    # exactly the "stranded on Drive" problem this verb exists to catch.
    EXCL+=("${GIT_EXCLUDE_PATTERNS[@]}")
    (( ${#EXCL[@]} )) || die "No exclude rules found — nothing can be orphaned."
    INC=()
    for pat in "${EXCL[@]}"; do INC+=(--include "$pat"); done

    logmsg "remote=$REMOTE_PATH filters=$FILE_FILTERS"
    logmsg "patterns: ${EXCL[*]}"
    yellow "Exclude patterns, read from $FILE_FILTERS:"
    printf '  %s\n' "${EXCL[@]}"
    cat <<'EOF'

Files on Drive matching these were uploaded before the rule existed. No sync sees
them, so nothing will ever move or remove them. That is what makes them orphans.

Read the list below. These patterns are whatever your filter file says TODAY — if
you added a broad exclude recently, its files on Drive appear here too, and those
may be files you still want.
EOF
    echo
    listing="$(mktemp)"
    # stderr is deliberately NOT redirected. rclone writes the config password
    # prompt to stderr, and sending it to the log turns "asking you something"
    # into "hung for no reason" — with stdout already going to $listing there
    # would be nothing on screen at all. Same trap as the one fixed in 'status'.
    rclone ls "$REMOTE_PATH" "${INC[@]}" >"$listing" || {
      rm -f "$listing"; die "Could not list $REMOTE_PATH."; }
    n=$(wc -l < "$listing")
    if (( n == 0 )); then
      rm -f "$listing"; logmsg "RESULT: none found"
      green "No orphans on Drive — nothing to clean up."
      exit 0
    fi
    bytes=$(awk '{s+=$1} END{print s+0}' "$listing")
    yellow "$n file(s), $(numfmt --to=iec "$bytes" 2>/dev/null || echo "$bytes B") on Drive:"
    head -40 "$listing" | sed 's/^/  /'
    if (( n > 40 )); then echo "  ... and $((n - 40)) more — full list in the log"; fi
    { echo "--- orphans found ---"; cat "$listing"; } >> "$LOG"

    # Parent directories of the orphans about to be deleted, so the later
    # cleanup pass only ever descends into paths this run actually touched —
    # never a blind sweep of the whole remote (that used to reach into
    # unrelated, currently-excluded projects elsewhere on Drive).
    mapfile -t ORPHAN_DIRS < <(
      awk '{ sub(/^[[:space:]]*[0-9]+[[:space:]]+/, ""); print }' "$listing" \
        | while IFS= read -r p; do dirname -- "$p"; done \
        | grep -v '^\.$' | sort -u
    )
    rm -f "$listing"

    if [[ "$MODE" == orphans-check ]]; then
      logmsg "RESULT: listed only — nothing was deleted"
      echo
      green "Read-only — nothing was deleted."
      echo "To remove them:  42sync orphans-apply"
      exit 0
    fi

    if [[ -n "${2:-}" ]]; then
      [[ "$2" == "DELETE" ]] || die "Expected DELETE as the confirmation argument, got '$2'."
    else
      echo
      read -r -p "Press Enter to see the delete dry run (Ctrl-C to abort) " _ || true
      rclone delete "$REMOTE_PATH" "${INC[@]}" --dry-run --verbose 2>&1 | tee -a "$LOG"
      echo
      yellow "Nothing has been deleted yet."
      read -r -p "Type DELETE to remove them from Drive: " reply || true
      if [[ "$reply" != "DELETE" ]]; then
        logmsg "RESULT: aborted at the confirmation prompt — nothing was deleted"
        die "Aborted — nothing was changed."
      fi
    fi
    logmsg "confirmed — deleting $n file(s)"

    rclone delete "$REMOTE_PATH" "${INC[@]}" --verbose 2>&1 | tee -a "$LOG"
    rc=${PIPESTATUS[0]}
    (( rc == 0 )) || { logmsg "RESULT: delete failed (rc=$rc)"; die "Delete failed."; }
    logmsg "RESULT: deleted $n file(s), $bytes bytes — recoverable from Drive trash"

    if (( ${#ORPHAN_DIRS[@]} )); then
      echo
      yellow "Removing directories left empty ..."
      echo "Errors here are expected and harmless: under the drive.file scope rclone"
      echo "cannot remove a folder that holds anything it did not create."
      # Scoped to exactly the directories the deleted orphans lived in --
      # never the whole remote. A blanket 'rclone rmdirs "$REMOTE_PATH"' here would
      # walk every other project on Drive too, including ones excluded on
      # this machine, and attempt rmdir against directories this run has no
      # business touching (harmless in practice under drive.file's own
      # permission wall, but the wrong thing to even attempt).
      for d in "${ORPHAN_DIRS[@]}"; do
        rclone rmdirs "$REMOTE_PATH/$d" --leave-root --verbose 2>&1 | tee -a "$LOG" || true
      done
    fi

    echo
    green "Done. Deleted files sit in Drive's trash for about 30 days."
    echo "bisync is unaffected — these files were never in its listings."
    ;;

  # Give every repo that has a remote, but none of them a github.com remote
  # the user owns, a private GitHub repo of its own. Never touches a repo
  # with no remote at all (left alone) or one that already has an owned
  # github.com remote. A separate opt-in verb rather than folded into plain
  # apply/check -- this creates real GitHub repos and pushes to them, a
  # one-time, semi-consequential action per repo that deserves its own
  # explicit preview-then-confirm step, the same way
  # force-apply/orphans-apply/resync-apply already get one for their own
  # kind of consequential action.
  onboard-check|onboard-apply)
    require_local
    scan_onboard_candidates

    if (( ${#ONBOARD_SKIPPED_BROKEN[@]} )); then
      yellow "Skipped -- .git exists but isn't a valid repo (a real machine can end up with one that has HEAD/config but no objects/refs, e.g. from an interrupted clone):"
      printf '  %s\n' "${ONBOARD_SKIPPED_BROKEN[@]}"
      echo
    fi

    if (( ${#ONBOARD_CANDIDATES[@]} == 0 && ${#ONBOARD_MARKER_ONLY[@]} == 0 )); then
      logmsg "RESULT: nothing to onboard"
      green "Nothing to onboard -- every repo either has no remote at all (left alone)"
      echo "or already has a github.com remote you own and a marker."
      exit 0
    fi

    if (( ${#ONBOARD_CANDIDATES[@]} )); then
      github_owner || die "Could not determine your GitHub login (gh api user failed).
Run 'gh auth login' first -- see the TODO from 42sync_install.sh if you haven't."

      yellow "${#ONBOARD_CANDIDATES[@]} repo(s) need a GitHub repo of their own (account: $GITHUB_OWNER):"
      for rel in "${ONBOARD_CANDIDATES[@]}"; do
        name="$(repo_onboard_name "$rel")"
        printf '  %-55s -> %s/%s\n' "$rel" "$GITHUB_OWNER" "$name"
      done
      cat <<'EOF'

For each: creates a new PRIVATE repo under your GitHub account, adds it as
remote "github", pushes once to seed it, and writes .42sync-remote recording
every remote (old and new). Never touches vogsphere or any other existing
remote.
EOF
    fi

    if (( ${#ONBOARD_MARKER_ONLY[@]} )); then
      echo
      yellow "${#ONBOARD_MARKER_ONLY[@]} repo(s) already have a github.com remote you own, just need the marker written:"
      printf '  %s\n' "${ONBOARD_MARKER_ONLY[@]}"
      echo "No new repo, no push -- just writes .42sync-remote from the remotes already there."
    fi

    if [[ "$MODE" == onboard-check ]]; then
      echo
      logmsg "RESULT: listed only -- nothing was created"
      green "Preview only -- nothing was created. Run 'onboard-apply' to do it for real."
      exit 0
    fi

    total=$(( ${#ONBOARD_CANDIDATES[@]} + ${#ONBOARD_MARKER_ONLY[@]} ))
    if [[ -n "${2:-}" ]]; then
      [[ "$2" == "ONBOARD" ]] || die "Expected ONBOARD as the confirmation argument, got '$2'."
    else
      echo
      read -r -p "Type ONBOARD to apply to $total repo(s) for real: " reply || true
      if [[ "$reply" != "ONBOARD" ]]; then
        logmsg "RESULT: aborted at the confirmation prompt -- nothing was created"
        die "Aborted — nothing was created."
      fi
    fi
    logmsg "confirmed -- onboarding $total repo(s)"

    echo
    failed=0
    for rel in "${ONBOARD_CANDIDATES[@]}"; do
      repo="$LOCAL_PATH/$rel"
      name="$(repo_onboard_name "$rel")"
      if git -C "$repo" remote get-url github >/dev/null 2>&1; then
        red "skip       $rel -- a remote named 'github' already exists (not created by this run); resolve by hand."
        logmsg "skip $rel: remote 'github' already exists"
        failed=1
        continue
      fi
      logmsg "onboarding $rel -> $GITHUB_OWNER/$name"
      if gh repo create "$name" --private --source="$repo" --remote=github --push >>"$LOG" 2>&1; then
        write_marker "$repo"
        green "onboarded  $rel -> $GITHUB_OWNER/$name"
      else
        red "failed     $rel -> $GITHUB_OWNER/$name -- see $LOG"
        logmsg "FAILED onboarding $rel"
        failed=1
      fi
    done
    for rel in "${ONBOARD_MARKER_ONLY[@]}"; do
      repo="$LOCAL_PATH/$rel"
      logmsg "writing marker only for $rel (already has an owned github.com remote)"
      write_marker "$repo"
      green "marker written  $rel"
    done
    echo
    if (( failed )); then
      logmsg "RESULT: completed with at least one failure or skip"
      yellow "Some repos failed or were skipped -- see above and the log: $LOG"
    else
      logmsg "RESULT: onboarded $total repo(s)"
      green "Onboarding complete."
    fi
    ;;

  # ADR-0001's other half: a machine that received an onboarded repo's
  # working-tree files via Drive but never cloned it itself. Detects "has
  # the marker, no local .git" and prints the resolved clone command --
  # never runs it, deliberately: cloning into a folder that already has
  # bisync-delivered files needs care (the target isn't empty), so this
  # stays a printed recipe, same as every other consequential path in this
  # toolkit. No check/apply split -- nothing here is ever applied by this
  # script itself.
  reconstitute)
    require_local
    found=0
    while IFS= read -r -d '' marker; do
      repo="$(dirname "$marker")"
      rel="${repo#$LOCAL_PATH/}"
      # A .git FILE (not a directory) is a submodule or `git worktree add`
      # gitlink -- already a legitimate, working checkout, just not in the
      # usual shape. Only a repo with NEITHER needs reconstituting.
      [[ -e "$repo/.git" ]] && continue
      found=1

      # onboard-apply always names the remote it creates "github" -- the
      # only writer of this marker today, so that line is the safe
      # bootstrap source. Falls back to the marker's first line if that
      # ever changes and no line is named "github".
      url="$(awk -F'\t' '$1 == "github" {print $2; exit}' "$marker")"
      [[ -n "$url" ]] || url="$(awk -F'\t' 'NR==1{print $2}' "$marker")"
      if [[ -z "$url" ]]; then
        yellow "skip       $rel -- marker exists but is empty or unreadable"
        continue
      fi

      # basename first (command substitution strips its trailing newline),
      # THEN sanitize via bash's own substitution -- piping straight into
      # `tr -c` instead would translate that trailing newline into an
      # extra, unwanted "-" of its own before it ever gets stripped.
      safe_name="$(basename "$rel")"
      safe_name="${safe_name//[^A-Za-z0-9._-]/-}"
      echo
      yellow "$rel has a marker but no .git:"
      cat <<EOF
  git clone "$url" "/tmp/${safe_name}-reconstituted"
  # Compare its checkout against the working tree already here (it arrived
  # via Drive, so it should mostly match) -- then move its .git into place:
  mv "/tmp/${safe_name}-reconstituted/.git" "$repo/.git"
  cd "$repo" && git status
  # Anything git reports as modified is real content that reached this
  # machine after the clone's last commit -- review it, don't discard it.
  rm -rf "/tmp/${safe_name}-reconstituted"
EOF
    done < <(find -H "$LOCAL_PATH" -type f -name "$MARKER_FILENAME" -print0 2>/dev/null)

    if (( ! found )); then
      logmsg "RESULT: nothing needs reconstituting"
      green "Nothing needs reconstituting -- every marker has a local .git already."
    else
      logmsg "RESULT: listed reconstitution commands -- nothing was run"
      echo
      yellow "Nothing above was run. Copy the commands for whichever repo you want to fix."
    fi
    ;;

  status)
    echo "Local:  $LOCAL_PATH"
    du -sh "$LOCAL_PATH" 2>/dev/null || echo "  (does not exist yet — run: 42sync seed)"
    [[ -f "$LOCAL_PATH/RCLONE_TEST" ]] && green "  access marker present" || yellow "  access marker MISSING"
    echo
    echo "Remote: $REMOTE_PATH"
    rclone size "$REMOTE_PATH" "${FILTER_ARGS[@]}" || true
    echo
    echo "Baseline: $WORK_PATH"
    if ls "$WORK_PATH"/*.lst >/dev/null 2>&1; then
      green "  present ($(ls -1 "$WORK_PATH"/*.lst 2>/dev/null | wc -l) listing files)"
    else
      yellow "  MISSING — next run needs resync-apply"
    fi
    echo
    echo "Recent runs:"
    recent="$(ls -1t "$LOG_PATH"/42sync-*.log 2>/dev/null | grep -v -- '-last\.log$' | head -5)"
    if [[ -n "$recent" ]]; then
      printf '%s\n' "$recent" | sed 's|^|  |'
    else
      echo "  (none)"
    fi
    ;;

  configure-set)
    [[ $# -eq 3 ]] || die "Usage: 42sync configure-set <name> <value>"
    configure_set "$2" "$3"
    ;;

  configure-reset)
    [[ $# -eq 2 ]] || die "Usage: 42sync configure-reset <name>"
    configure_reset "$2"
    ;;

  configure-show)
    configure_show
    ;;

  dirty-check|dirty-apply)
    require_local
    check_repos
    red "WARNING: this can corrupt a repo's .git if it has genuinely diverged from Drive."
    echo "A real repo's .git/index was corrupted this way the day this mode was built."
    echo "See TROUBLESHOOTING.md: \"A repo's .git got corrupted by a bisync conflict.\""
    echo

    if [[ "$MODE" == dirty-check ]]; then
      yellow "Would sync ALL repos including ${#DIRTY_REPOS[@]} with uncommitted changes:"
      printf '  %s\n' "${DIRTY_REPOS[@]}"
      run_bisync "${COMMON[@]}" --dry-run
      green "Dry run only — nothing was changed. Run 'dirty-apply' once it looks right."
    else
      warn_no_multiplexer
      if [[ -n "${2:-}" ]]; then
        [[ "$2" == "DIRTY" ]] || die "Expected DIRTY as the confirmation argument, got '$2'."
      else
        yellow "Syncing ${#DIRTY_REPOS[@]} repo(s) with uncommitted changes anyway:"
        printf '  %s\n' "${DIRTY_REPOS[@]}"
        read -r -p "Type DIRTY to proceed: " reply || true
        [[ "$reply" == "DIRTY" ]] || die "Aborted — nothing was changed."
      fi
      run_bisync "${COMMON[@]}"
      green "Synced (dirty repos included)."
    fi
    ;;

  apply)
    require_local
    warn_no_multiplexer
    check_repos
    if (( ${#DIRTY_REPOS[@]} == 0 )); then
      run_bisync "${COMMON[@]}"
    else
      yellow "Skipping ${#DIRTY_REPOS[@]} repo(s) with uncommitted changes this run:"
      printf '  %s\n' "${DIRTY_REPOS[@]}"
      echo "Commit first, or run '42sync dirty-apply' to sync everything including these."
      echo
      compute_skip_args
      run_bisync "${COMMON[@]}" "${SKIP_ARGS[@]}"
    fi
    green "Synced."
    ;;

  *)
    die "unreachable: mode was validated at startup"
    ;;
esac
