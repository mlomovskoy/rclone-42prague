#!/usr/bin/env bash
#
# 42password — store the rclone config password in this OS's secret store
# (macOS Keychain / Linux secret-tool / Windows DPAPI) and wire it in via
# RCLONE_PASSWORD_COMMAND, so rclone and 42sync stop prompting on this machine.
#
#   42password         set it up (or confirm it already is), then verify it works
#   42password check   show what would happen, change nothing
#   42password force   re-store the password even if one is already saved
#                      (e.g. you changed the rclone config password)
#
# Deliberately NOT for the shared campus machine: this moves the barrier that
# protects rclone.conf from "knows the config password" to "is logged into this
# account". See README, Known limitations, before using it there.
#
# On Windows (Git for Windows' bash) there is no CLI secret store built in, so
# this generates a small helper script, ~/bin/rclone-password-helper.ps1, and a
# sibling ~/bin/rclone-password.enc holding the password encrypted with DPAPI —
# Windows' own per-user-account encryption, the same one Credential Manager
# uses under the hood. It decrypts only for this Windows account on this
# machine, which is the same tradeoff as Keychain/secret-tool above, not a
# weaker one: the .enc file is useless copied anywhere else.

set -uo pipefail

SERVICE="rclone-config"
LOGDIR="$HOME/.local/state/42sync"
KEEP_LOGS=20

mkdir -p "$LOGDIR"
LOG="$LOGDIR/password-$(date +%Y-%m-%d-%H%M%S).log"

if [[ -t 1 ]]; then
  C_RED=$'\033[31m'; C_GRN=$'\033[32m'; C_YEL=$'\033[33m'; C_OFF=$'\033[0m'
else
  C_RED=""; C_GRN=""; C_YEL=""; C_OFF=""
fi

logmsg() { printf '%s\n' "$*" >> "$LOG" 2>/dev/null || true; }
say()    { printf '%s\n' "$*";                       logmsg "$*"; }
red()    { printf '%s%s%s\n' "$C_RED" "$*" "$C_OFF"; logmsg "$*"; }
green()  { printf '%s%s%s\n' "$C_GRN" "$*" "$C_OFF"; logmsg "$*"; }
yellow() { printf '%s%s%s\n' "$C_YEL" "$*" "$C_OFF"; logmsg "$*"; }
die()    { red "$*" >&2; logmsg "RESULT: failed"; exit 1; }

prune_logs() {
  local n
  n=$(ls -1t "$LOGDIR"/password-*.log 2>/dev/null | wc -l)
  if (( n > KEEP_LOGS )); then
    ls -1t "$LOGDIR"/password-*.log | tail -n +$((KEEP_LOGS+1)) | xargs -r rm --
  fi
}

on_exit() { prune_logs; printf '%sLog: %s%s\n' "$C_GRN" "$LOG" "$C_OFF"; }
trap on_exit EXIT

have() { command -v "$1" >/dev/null 2>&1; }

# Windows-native tools (powershell.exe) do not understand Git Bash's POSIX-style
# paths. cygpath ships with the same MSYS runtime Git Bash does, so it is safe
# to assume alongside it — same reasoning as 42install's copy of this helper.
to_winpath() {
  if have cygpath; then cygpath -w "$1"; else printf '%s' "$1"; fi
}

MODE="${1:-install}"
DRY=0
FORCE=0
case "$MODE" in
  install) ;;
  check)   DRY=1 ;;
  force)   FORCE=1 ;;
  *)       die "Usage: 42password [check|force]" ;;
esac

case "$(uname -s)" in
  Darwin)                OS=osx ;;
  Linux)                 OS=linux ;;
  MINGW*|MSYS*|CYGWIN*)  OS=windows ;;
  *)      die "Unsupported OS: $(uname -s). This covers macOS, Linux, and
Windows via Git for Windows' bash (not native cmd/PowerShell)." ;;
esac

# Where the Windows helper and its encrypted sibling live. Same directory
# 42install puts rclone/42sync/42links in, so there is nowhere new to look.
WIN_BINDIR="$HOME/bin"
WIN_HELPER="$WIN_BINDIR/rclone-password-helper.ps1"
WIN_ENCFILE="$WIN_BINDIR/rclone-password.enc"

# Same shell-rc detection as 42install, so this lands in the file that already
# has the PATH entry rather than a second, easy-to-miss one. Git for Windows'
# bash reports $SHELL as .../bash.exe, not bash — strip the extension so this
# matches the same way it does on Linux and macOS.
SHELLNAME="${SHELL##*/}"; SHELLNAME="${SHELLNAME%.exe}"
case "$SHELLNAME" in
  zsh)  RC="$HOME/.zshrc" ;;
  bash) RC="$HOME/.bashrc" ;;
  *)    die "Unsupported shell '$SHELLNAME' — add RCLONE_PASSWORD_COMMAND to your shell rc by hand." ;;
esac

already_stored() {
  case "$OS" in
    osx)     security find-generic-password -a "$USER" -s "$SERVICE" -w >/dev/null 2>&1 ;;
    linux)   secret-tool lookup service "$SERVICE" username "$USER" >/dev/null 2>&1 ;;
    windows) [[ -f "$WIN_ENCFILE" ]] ;;
  esac
}

# For running right now, in this script -- the actual username / path, resolved.
password_command() {
  case "$OS" in
    osx)     printf 'security find-generic-password -a %s -s %s -w' "$USER" "$SERVICE" ;;
    linux)   printf 'secret-tool lookup service %s username %s' "$SERVICE" "$USER" ;;
    windows) printf 'powershell.exe -NoProfile -NonInteractive -File %s' "$(to_winpath "$WIN_HELPER")" ;;
  esac
}

# For writing into the shell rc. On macOS/Linux this is a literal $USER, NOT
# resolved: baking in today's username would silently break if this rc file is
# ever reused under a different account, and would also never match an
# existing hand-written line (same literal-$USER convention), causing a
# duplicate. On Windows the path is resolved the same way, but deferred: the
# unevaluated $(cygpath ...) call is what gets written to the rc file, and only
# runs when that file is later sourced -- so a copy of ~/bin under a different
# Windows profile still resolves correctly rather than pointing at this one.
password_command_rc() {
  case "$OS" in
    osx)     printf 'security find-generic-password -a $USER -s %s -w' "$SERVICE" ;;
    linux)   printf 'secret-tool lookup service %s username $USER' "$SERVICE" ;;
    windows) printf 'powershell.exe -NoProfile -NonInteractive -File $(cygpath -w "$HOME/bin/rclone-password-helper.ps1")' ;;
  esac
}

store_password() {
  case "$OS" in
    osx)
      have security || die "security CLI not found — unexpected on macOS."
      local pw
      # zsh's `read -p` means "read from a coprocess", not "show this prompt" —
      # print the prompt separately rather than hit that by surprise.
      printf 'rclone config password: '
      read -r -s pw; echo
      [[ -n "$pw" ]] || die "Empty password, nothing stored."
      security add-generic-password -a "$USER" -s "$SERVICE" -w "$pw" -U 2>>"$LOG" \
        || die "Could not store the password in Keychain. See: $LOG"
      unset pw
      ;;
    linux)
      have secret-tool || die "secret-tool not found. Install it first:
  Debian/Ubuntu:  sudo apt install libsecret-tools
  Fedora:         sudo dnf install libsecret"
      # secret-tool prompts for the value itself (hidden) — no separate read.
      secret-tool store --label="rclone config password" service "$SERVICE" username "$USER" 2>>"$LOG" \
        || die "Could not store the password via secret-tool.
Most likely no keyring daemon is unlocked in this session (normal after a
desktop login, not guaranteed on every campus machine). See: $LOG"
      ;;
    windows)
      have powershell.exe || die "powershell.exe not found — unexpected on Windows."
      mkdir -p "$WIN_BINDIR"
      # Regenerated every run so a change to this script always propagates,
      # rather than a stale copy from an earlier version silently sticking
      # around. It only ever reads its own sibling .enc file.
      cat > "$WIN_HELPER" <<'PS1'
# Decrypts the sibling .enc file with Windows DPAPI, which ties it to this
# Windows user account on this machine -- the same "logged in, not literally
# knows the password" tradeoff 42password makes on macOS (Keychain) and Linux
# (secret-tool). Exits 1 with no output if the file is missing, rather than
# hanging or prompting -- RCLONE_PASSWORD_COMMAND must never do either.
$encPath = Join-Path $PSScriptRoot 'rclone-password.enc'
if (-not (Test-Path -LiteralPath $encPath)) { exit 1 }
$secure = Get-Content -Raw -LiteralPath $encPath | ConvertTo-SecureString
$bstr = [Runtime.InteropServices.Marshal]::SecureStringToBSTR($secure)
try {
  [Runtime.InteropServices.Marshal]::PtrToStringBSTR($bstr)
} finally {
  [Runtime.InteropServices.Marshal]::ZeroFreeBSTR($bstr)
}
PS1
      # Deliberately no -NonInteractive here: unlike every other PowerShell
      # call in this toolkit, this one's whole job is to prompt. -NonInteractive
      # suppresses PowerShell's own interactive prompts, Read-Host included.
      powershell.exe -NoProfile -Command \
        "\$sec = Read-Host -AsSecureString -Prompt 'rclone config password'; if (\$sec.Length -eq 0) { exit 1 }; \$sec | ConvertFrom-SecureString | Set-Content -NoNewline -LiteralPath '$(to_winpath "$WIN_ENCFILE")'" \
        || die "Could not store the password via DPAPI (empty input, or Ctrl-C). See: $LOG"
      ;;
  esac
}

RC_LINE="export RCLONE_PASSWORD_COMMAND=\"$(password_command_rc)\""

logmsg "=== 42password $MODE $(date '+%F %T') os=$OS host=$(uname -n) ==="

if (( DRY )); then
  yellow "Dry run — nothing will be changed."
  echo
fi
say "Target: $OS, secret store service '$SERVICE', shell rc ${RC/#$HOME/\~}"
echo

if already_stored && (( ! FORCE )); then
  green "ok         password already stored"
elif (( DRY )); then
  if (( FORCE )); then
    yellow "would re-prompt for and overwrite the stored password (force)"
  else
    yellow "would prompt for and store the rclone config password"
  fi
else
  store_password
  case "$OS" in
    osx)     store_label="Keychain" ;;
    linux)   store_label="Linux keyring" ;;
    windows) store_label="a DPAPI-encrypted file (${WIN_ENCFILE/#$HOME/\~})" ;;
  esac
  green "stored     rclone config password in $store_label"
fi

if grep -qxF -- "$RC_LINE" "$RC" 2>/dev/null; then
  green "ok         RCLONE_PASSWORD_COMMAND already in ${RC/#$HOME/\~}"
elif (( DRY )); then
  yellow "would add  RCLONE_PASSWORD_COMMAND to ${RC/#$HOME/\~}"
else
  printf '%s\n' "$RC_LINE" >> "$RC"
  green "added      RCLONE_PASSWORD_COMMAND to ${RC/#$HOME/\~}"
fi

echo
if (( DRY )); then
  yellow "Dry run — nothing was changed."
  logmsg "RESULT: dry run only"
  exit 0
fi

# Verify end-to-end with a real, harmless rclone call — in-process, so it does
# not depend on this shell (or a new one) having re-read the rc file yet.
say "Verifying: rclone listremotes using the new password command ..."
if RCLONE_PASSWORD_COMMAND="$(password_command)" rclone listremotes >/dev/null 2>>"$LOG"; then
  green "Verified — rclone decrypts the config with no prompt."
else
  red "rclone still could not decrypt the config non-interactively."
  say "The stored password may not match rclone.conf's actual password. See: $LOG"
  exit 1
fi

echo
green "Done. Open a new shell (or: exec ${SHELL##*/}) to pick this up everywhere."
logmsg "RESULT: ok"
