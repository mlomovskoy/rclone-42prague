#!/usr/bin/env bash
#
# 42links — create convenience symlinks to the synced 42 folders. Run with
# no arguments to see every verb this script accepts.
#
# Creates, in $HOME, $HOME/Documents and $HOME/Downloads:
#
#   docs   -> ~/Projects/42Prague/docs     (subjects, PDFs, resources)
#   repos  -> ~/Projects/42Prague/repos    (project repositories)
#
# These live in $HOME, which on a campus machine is a per-user volume that follows
# you between seats — so this is once per home volume, not once per seat.

set -euo pipefail

BASE="$HOME/Projects/42Prague"
SYNC_ROOT="$HOME/Projects"
# Compared below against destinations resolved with `pwd -P`. Resolve this one too:
# if any component of $HOME is itself a symlink, an unresolved value here would fail
# to match and the guard would silently pass.
SYNC_ROOT_REAL="$(cd "$SYNC_ROOT" 2>/dev/null && pwd -P || echo "$SYNC_ROOT")"

# link name -> target under $BASE
LINK_NAMES=(docs repos)

# where to place them
DIRS=("$HOME" "$HOME/Documents" "$HOME/Downloads")

LOGDIR="$HOME/.local/state/42sync"
KEEP_LOGS=20

red()   { printf '\033[31m%s\033[0m\n' "$*"; logmsg "$*"; }
green() { printf '\033[32m%s\033[0m\n' "$*"; logmsg "$*"; }
yellow(){ printf '\033[33m%s\033[0m\n' "$*"; logmsg "$*"; }
die()   { red "$*" >&2; logmsg "RESULT: failed"; exit 1; }
logmsg() { [[ -n "${LOG:-}" ]] || return 0; printf '%s\n' "$*" >> "$LOG" 2>/dev/null || true; }

VERBS=(apply check clean-check clean-apply status)

print_verbs() {
  cat <<'EOF'
42links <verb>

  apply         create/refresh the links
  check         dry run of apply -- shows what would happen, changes nothing
  clean-check   preview removing links this script created
  clean-apply   remove them for real
  status        show current state, including broken links
EOF
}

if [[ $# -eq 0 ]]; then
  print_verbs
  exit 0
fi

MODE="$1"

if [[ "$MODE" == __complete ]]; then
  printf '%s\n' "${VERBS[@]}"
  exit 0
fi

valid=0
for v in "${VERBS[@]}"; do [[ "$MODE" == "$v" ]] && valid=1 && break; done
(( valid )) || { printf '\033[31mUnknown verb '"'"'%s'"'"'. Run '"'"'42links'"'"' with no arguments to see the list.\033[0m\n' "$MODE" >&2; exit 1; }

# Same directory and rotation policy as 42sync and 42sync_install.sh, so
# there is one place to look. Prefixed with the script's own name so logs
# stay identifiable even though "apply"/"check" are shared verb names with
# other scripts in the same $LOGDIR.
mkdir -p "$LOGDIR"
LOG="$LOGDIR/42links-$MODE-$(date +%Y-%m-%d-%H%M%S).log"
: > "$LOG"
ln -sfn "$LOG" "$LOGDIR/42links-$MODE-last.log"
logmsg "=== 42links $MODE $(date '+%F %T') host=$(uname -n) ==="

prune_logs() {
  local keep
  keep=$(ls -1t "$LOGDIR"/42links-{apply,check,clean-check,clean-apply,status}-*.log 2>/dev/null) || true
  [[ -n "$keep" ]] || return 0
  printf '%s\n' "$keep" | tail -n +$((KEEP_LOGS+1)) | xargs -r rm --
}

# Printed on every exit path, however the script ends.
on_exit() { prune_logs; printf '\033[32mLog: %s\033[0m\n' "$LOG"; }
trap on_exit EXIT

DRY=0
[[ "$MODE" == check ]] && { MODE=apply; DRY=1; }
[[ "$MODE" == clean-check ]] && { MODE=clean-apply; DRY=1; }

# Never place a link inside the synced tree: with rclone's --links it would be
# mirrored to Drive as a .rclonelink pointing at a path that differs per machine.
for d in "${DIRS[@]}"; do
  case "$(cd "$d" 2>/dev/null && pwd -P || echo "$d")" in
    "$SYNC_ROOT_REAL"|"$SYNC_ROOT_REAL"/*)
      die "Refusing to run: $d is inside the synced tree ($SYNC_ROOT)." ;;
  esac
done

case "$MODE" in

  apply)
    [[ -d "$BASE" ]] || die "Target missing: $BASE
Run '42sync seed' first, or fix BASE at the top of this script."

    for name in "${LINK_NAMES[@]}"; do
      target="$BASE/$name"
      if [[ ! -d "$target" ]]; then
        yellow "skip     $name  (no such directory: $target)"
        continue
      fi
      for d in "${DIRS[@]}"; do
        [[ $DRY -eq 1 ]] || mkdir -p "$d"
        link="$d/$name"
        if [[ -L "$link" ]]; then
          current="$(readlink "$link")"
          if [[ "$current" == "$target" ]]; then
            green "ok       $link"
          else
            [[ $DRY -eq 1 ]] || ln -sfn "$target" "$link"
            green "repoint  $link  (was -> $current)"
          fi
        elif [[ -e "$link" ]]; then
          yellow "SKIPPED  $link  (exists and is not a symlink — left untouched)"
        else
          [[ $DRY -eq 1 ]] || ln -s "$target" "$link"
          green "created  $link"
        fi
      done
    done
    # Not `[[ ... ]] && yellow`: on a real run the test fails, that status becomes
    # the case statement's, and the script exits 1 despite having done its job.
    if [[ $DRY -eq 1 ]]; then
      yellow "
Dry run — nothing was changed. Run 'apply' once it looks right."
    fi
    ;;

  clean-apply)
    for name in "${LINK_NAMES[@]}"; do
      for d in "${DIRS[@]}"; do
        link="$d/$name"
        if [[ -L "$link" ]]; then
          current="$(readlink "$link")"
          case "$current" in
            "$BASE"/*|"$BASE")
              if [[ $DRY -eq 1 ]]; then
                yellow "would remove  $link  (-> $current)"
              else
                rm "$link"; green "removed  $link"
              fi
              ;;
            *)
              yellow "kept     $link  (points outside $BASE -> $current)" ;;
          esac
        fi
      done
    done
    if [[ $DRY -eq 1 ]]; then
      yellow "
Dry run — nothing was changed. Run 'clean-apply' once it looks right."
    fi
    ;;

  status)
    echo "Base: $BASE"
    [[ -d "$BASE" ]] || yellow "  (missing)"
    echo
    for name in "${LINK_NAMES[@]}"; do
      for d in "${DIRS[@]}"; do
        link="$d/$name"
        if [[ -L "$link" ]]; then
          if [[ -e "$link" ]]; then
            green   "ok       $link -> $(readlink "$link")"
          else
            red     "BROKEN   $link -> $(readlink "$link")"
          fi
        elif [[ -e "$link" ]]; then
          yellow    "real dir $link  (not a symlink)"
        else
          echo      "absent   $link"
        fi
      done
    done
    ;;

  *)
    die "unreachable: mode was validated at startup"
    ;;
esac
