#!/usr/bin/env bash
#
# 42sync — two-way sync of ~/Projects with gdrive:_projects_rclone via rclone bisync.
#
#   42sync           normal run: two-way sync
#   42sync check     dry run: show what WOULD change, touch nothing
#   42sync verify    compare real content: is everything local actually on Drive?
#   42sync force     push through a rename/reorg (bypasses the delete guard, asks first)
#   42sync orphans        delete excluded files stranded on Drive (asks twice)
#   42sync orphans check  list them and stop -- deletes nothing
#   42sync seed      ~/Projects is empty: pull from Drive, then set the baseline
#   42sync resync    first sync when BOTH sides already have real content (one-time)
#   42sync status    local size, remote size, recent runs
#   42sync logs      list kept logs (the one mode that writes no log of its own)
#   42sync projects  choose which projects sync to THIS machine
#
# Install:  mkdir -p ~/bin && cp 42sync ~/bin/ && chmod +x ~/bin/42sync

set -uo pipefail

LOCAL="$HOME/Projects"
REMOTE="gdrive:_projects_rclone"
FILTERS="$HOME/.config/rclone/projects-filters.txt"

# Which projects sync to THIS machine. Deliberately a SEPARATE file from
# $FILTERS, not another section in it, for one reason: '42sync orphans' treats
# everything excluded by $FILTERS as junk on Drive that nothing will ever manage
# and offers to delete it. Project selections are the opposite — files kept on
# Drive on purpose, usually by another machine. Mixing the two would point the
# cleanup at exactly the data it must never touch.
#
# It lives in ~/.config (never synced), so each machine chooses for itself.
LOCAL_FILTERS="$HOME/.config/rclone/projects-local.txt"
LOGDIR="$HOME/.local/state/42sync"
# bisync's listings live here, NOT in ~/.cache — campus machines clear the cache
# between sessions, and losing the listings means a forced --resync every time.
WORKDIR="$HOME/.local/state/42sync/bisync"
KEEP_LOGS=20

mkdir -p "$LOGDIR" "$WORKDIR" "$(dirname "$FILTERS")"

if [[ ! -f "$FILTERS" ]]; then
  cat > "$FILTERS" <<'EOF'
# Excluded from sync. Lines starting with "- " are excludes.
# .git is deliberately NOT excluded — repos sync whole.
- .DS_Store
- .Trash-*/**
- **/*.o
- **/*.out
- a.out
- **/.cache/**
# Claude Code's own runtime state under ~/Projects (e.g. scheduled_tasks.lock)
# -- not project content, and sync only runs on demand, so a synced copy is
# always stale rather than useful.
- .claude/**
EOF
  echo "Created filter file: $FILTERS"
fi

if [[ ! -f "$LOCAL_FILTERS" ]]; then
  cat > "$LOCAL_FILTERS" <<'EOF'
# Projects NOT synced to this machine. Managed by: 42sync projects
#
# Excluding a path here stops it coming down to this machine. The copy on Drive
# is left completely alone -- not transferred, not deleted -- so another machine
# can keep using it. Re-include it and the next sync pulls it down.
#
# This file is per-machine and is never synced.
EOF
fi

# Both filter files, in one place, for every command that must see what this
# machine actually syncs. NOT used by 'orphans' -- see the note on LOCAL_FILTERS.
FILTER_ARGS=(--filter-from "$FILTERS")
if grep -qE '^- ' "$LOCAL_FILTERS" 2>/dev/null; then
  FILTER_ARGS+=(--filter-from "$LOCAL_FILTERS")
fi

# --check-access  refuses to run unless RCLONE_TEST markers exist on BOTH sides.
# --max-delete    aborts if >25% of files would vanish ('force' bypasses this).
# --links         stores symlinks as .rclonelink files instead of skipping them.
COMMON=(
  --workdir "$WORKDIR"
  "${FILTER_ARGS[@]}"
  --check-access
  --max-delete 25
  --links
  --verbose
)

red()    { printf '\033[31m%s\033[0m\n' "$*"; }
green()  { printf '\033[32m%s\033[0m\n' "$*"; }
yellow() { printf '\033[33m%s\033[0m\n' "$*"; }
die()    { red "$*" >&2; exit 1; }

# Terminal output is not otherwise logged — rclone's is, via tee. Used by the
# destructive paths to record the decision, so a log answers "did this actually
# delete anything?" without needing to have watched it happen.
logmsg() { [[ -n "${LOG:-}" ]] || return 0; printf '%s\n' "$*" >> "$LOG" 2>/dev/null || true; }

MODE="${1:-sync}"

# Validate before building a log name, so a typo does not leave a stray
# bogus-<timestamp>.log behind.
case "$MODE" in
  sync|check|verify|force|orphans|projects|seed|resync|status|logs) ;;
  *) die "Usage: 42sync [sync|check|verify|force|orphans [check]|projects|seed|resync|status|logs]" ;;
esac

# Every run gets its own log, whatever the mode and however it ends. Created
# here rather than per-branch so the file always exists and the path printed on
# exit always points at something.
#
# 'logs' is the one exception: it exists to list the logs, so writing one would
# change the very thing it reports and leave a trail of entries that record
# nothing but having looked.
LOG=""
if [[ "$MODE" != logs ]]; then
  LOG="$LOGDIR/$MODE-$(date +%Y-%m-%d-%H%M%S).log"
  : > "$LOG"
  ln -sfn "$LOG" "$LOGDIR/last.log"
  logmsg "=== 42sync $MODE $(date '+%F %T') host=$(uname -n) ==="
fi

# Printed on EVERY exit path — success, failure, abort — so you never have to
# wonder where the evidence went. A trap rather than a line in each branch:
# there are nine ways out of this script and they were not all covering it.
# Rotation happens here too: every mode that writes a log also rotates, including
# the ones that run no rclone at all, so pruning cannot live in the sync paths only.
on_exit() { prune_logs; printf '\033[32mLog: %s\033[0m\n' "$LOG"; }
[[ -n "$LOG" ]] && trap on_exit EXIT

# Prunes this script's logs only, by mode prefix. 42install and 42links share
# $LOGDIR and prune their own, so no script deletes another's evidence.
prune_logs() {
  local keep
  keep=$(ls -1t "$LOGDIR"/{sync,check,verify,force,orphans,seed,resync,status,logs,mirror}-*.log 2>/dev/null)
  [[ -n "$keep" ]] || return 0
  printf '%s\n' "$keep" | tail -n +$((KEEP_LOGS+1)) | xargs -r rm --
}

# Long runs die with the terminal. Say so before, not after.
warn_no_multiplexer() {
  [[ -n "${TMUX:-}${STY:-}" ]] && return 0
  yellow "Not running inside tmux or screen."
  echo   "A large sync can take many minutes; closing this terminal kills it mid-run."
  echo   "Safer:  tmux new -s sync   then re-run this command inside it."
  echo
  read -r -p "Continue anyway? [y/N] " a || true
  [[ "$a" == [yY] ]] || die "Aborted."
}

require_local() {
  [[ -d "$LOCAL" ]] || die "$LOCAL does not exist.
On a campus seat your home follows you, so this is unexpected — check you are the
right user before assuming a fresh start. If it really is empty: 42sync seed"
  [[ -f "$LOCAL/RCLONE_TEST" ]] || die "Access marker missing from $LOCAL.
This usually means the local folder was wiped or is not the synced one.
Refusing to sync — inspect it first. Only run '42sync seed' if ~/Projects is
genuinely empty and you accept Drive as the source of truth."
}

# Drive is a mirror, and a mirror has no history. Two things are worth seeing before a
# run: work not committed at all, and commits that exist only on this machine. The
# second is the one that bites — vogsphere revokes write access once a project has been
# evaluated, so "just push it" is not always available. See README, Known limitations.
check_repos() {
  local repo dirty ahead
  while IFS= read -r -d '' gitdir; do
    repo="$(dirname "$gitdir")"
    dirty="$(git -C "$repo" status --porcelain 2>/dev/null)"
    ahead="$(git -C "$repo" log --oneline '@{u}..HEAD' 2>/dev/null)"
    [[ -n "$dirty" ]] && yellow "uncommitted changes: ${repo#$LOCAL/}"
    [[ -n "$ahead" ]] && yellow "unpushed commits ($(printf '%s\n' "$ahead" | wc -l)): ${repo#$LOCAL/}"
  done < <(find "$LOCAL" -type d -name .git -print0 2>/dev/null)
}

# Run bisync, keep the log, and translate rclone's cryptic failures.
run_bisync() {
  # Where this run's output starts. 'force' calls run_bisync twice into the same log,
  # so diagnosing against the whole file would match the dry run's message and report
  # the wrong cause for the real run's failure.
  local start=0
  [[ -f "$LOG" ]] && start=$(wc -c < "$LOG")
  rclone bisync "$LOCAL" "$REMOTE" "$@" 2>&1 | tee -a "$LOG"
  local rc=${PIPESTATUS[0]}
  if (( rc != 0 )); then
    local this_run
    this_run="$(tail -c "+$((start + 1))" "$LOG" 2>/dev/null)"
    echo
    if grep -q 'cannot find prior Path1 or Path2 listings' <<<"$this_run"; then
      red "No baseline exists for this path pair yet."
      cat <<EOF

bisync needs a starting point before it can tell changes from differences.
That happens when:
  - this is the first run on this machine, or
  - either path was renamed (the cache is keyed to exact paths), or
  - a previous run was interrupted before it wrote its listings.

  ~/Projects empty, Drive is truth    ->  42sync seed
  Both sides already have content     ->  42sync resync

Do not reach for --resync by hand: it copies each side's unique-or-newer file
to the other, which resurrects anything you deleted or renamed if the two
sides genuinely diverged rather than just never having met before.
EOF
    elif grep -q 'too many deletes' <<<"$this_run"; then
      red "Delete guard tripped."
      cat <<EOF

More than 25% of files would be removed. Usually this means you renamed or moved
directories — bisync compares by path, so a rename reads as mass deletion plus
mass creation.

Check the log, then:  42sync force
EOF
    elif grep -q 'Access test failed' <<<"$this_run"; then
      red "Access check failed — the RCLONE_TEST marker is missing on one side."
      echo
      echo "This guard exists to stop an empty local folder from wiping Drive."
      echo "Find out why it is gone before working around it."
    fi
    echo
    red "Failed."
    exit "$rc"
  fi
}

case "$MODE" in

  seed)
    warn_no_multiplexer
    echo "Seeding $LOCAL from $REMOTE ..."
    mkdir -p "$LOCAL"
    if [[ -n "$(ls -A "$LOCAL" 2>/dev/null)" ]]; then
      die "$LOCAL is not empty. 'seed' only runs against an empty folder.
Run '42sync check' first to see what a normal sync would do."
    fi
    rclone copy "$REMOTE" "$LOCAL" "${FILTER_ARGS[@]}" --links --verbose 2>&1 | tee -a "$LOG"
    # Stop here on a partial pull. Taking a baseline over a half-copied tree records
    # the missing files as "deleted locally", and the next sync removes them on Drive.
    (( PIPESTATUS[0] == 0 )) || die "Pull from $REMOTE failed.
Nothing was seeded. Fix the error above and run '42sync seed' again."
    touch "$LOCAL/RCLONE_TEST"
    rclone copy "$LOCAL/RCLONE_TEST" "$REMOTE" >/dev/null
    run_bisync "${COMMON[@]}" --resync
    green "Seeded. From now on just run: 42sync"
    ;;

  # For the other bootstrap case 'seed' does not cover: ~/Projects already has
  # real content (so 'seed' refuses), and no baseline exists yet for this exact
  # path pair (so plain bisync refuses too, with "cannot find prior listings").
  # That combination used to mean hand-typing a raw rclone bisync --resync
  # command; this mode is that command, with the same dry-run-then-confirm
  # guard as 'force'.
  resync)
    warn_no_multiplexer
    mkdir -p "$LOCAL"
    if [[ -z "$(ls -A "$LOCAL" 2>/dev/null)" ]]; then
      die "$LOCAL is empty — that is what 'seed' is for, not 'resync':
  42sync seed"
    fi
    # 'seed' creates this as part of pulling from an empty folder. Here neither
    # side is necessarily empty, so create it directly if this machine is new.
    [[ -f "$LOCAL/RCLONE_TEST" ]] || touch "$LOCAL/RCLONE_TEST"
    yellow "RESYNC MODE"
    cat <<'EOF'
Use this once, the first time this machine syncs against a Drive folder that
already has real content on one or both sides. 'seed' refused because
~/Projects is not empty; a plain sync refused because no baseline exists yet
for this exact path pair.

--resync copies each side's unique-or-newer file to the other side. It never
deletes anything. Where the same path exists on both sides and differs, the
newer modtime wins — check the dry run below for anything you would NOT want
overwritten that way.

After this, every future sync is just: 42sync
EOF
    echo
    read -r -p "Press Enter to see the dry run (Ctrl-C to abort) " _ || true
    run_bisync "${COMMON[@]}" --resync --dry-run
    echo
    yellow "Above is what WOULD happen. Nothing has changed yet."
    read -r -p "Type RESYNC to apply it for real: " reply || true
    [[ "$reply" == "RESYNC" ]] || die "Aborted — nothing was changed."
    run_bisync "${COMMON[@]}" --resync
    green "Resynced. From now on just run: 42sync"
    ;;

  check)
    require_local
    run_bisync "${COMMON[@]}" --dry-run
    green "Dry run only — nothing was changed."
    ;;

  # 'check' asks bisync what it would do, which it answers from its baseline.
  # 'verify' ignores the baseline and compares actual content, so it can catch
  # the case a baseline cannot: both sides agreeing on a record that is wrong.
  # Deliberately does not reuse COMMON — --workdir, --check-access and
  # --max-delete are bisync flags, and `rclone check` rejects them.
  verify)
    require_local
    yellow "Verifying that every local file exists on Drive ..."
    cat <<'EOF'
This reads both sides in full, so it takes a while. It is read-only — safe to
interrupt, and safe to run while you are doing something else.

--one-way: files that exist only on Drive are not reported. Excluded files (see
the filter file) are invisible to it on both sides, in both directions.
EOF
    echo
    miss="$(mktemp)"
    rclone check "$LOCAL" "$REMOTE" \
      "${FILTER_ARGS[@]}" \
      --links \
      --one-way \
      --missing-on-dst "$miss" \
      --verbose 2>&1 | tee -a "$LOG"
    rc=${PIPESTATUS[0]}
    if (( rc == 0 )); then
      rm -f "$miss"
      green "Verified — every local file is on Drive, with matching content."
    else
      echo
      red "Verification FAILED — local files are missing from Drive, or differ."
      if [[ -s "$miss" ]]; then
        n=$(wc -l < "$miss")
        echo
        yellow "$n file(s) missing on Drive:"
        head -20 "$miss" | sed 's/^/  /'
        if (( n > 20 )); then echo "  ... and $((n - 20)) more — full list in the log"; fi
        { echo "--- missing on Drive ---"; cat "$miss"; } >> "$LOG"
      fi
      rm -f "$miss"
      cat <<EOF

Most often this just means you have edited something since the last sync:

  42sync check     see what it would send
  42sync           send it
  42sync verify    confirm it landed

If '42sync check' reports "No changes found" while this still fails, then the
baseline agrees with neither side and is the thing that is wrong. Read the
--resync warning in TROUBLESHOOTING.md before reaching for it.
EOF
      exit "$rc"
    fi
    ;;

  force)
    require_local
    warn_no_multiplexer
    yellow "FORCE MODE"
    cat <<'EOF'
Use this only when bisync aborted with "too many deletes" because YOU renamed or
moved directories. bisync compares by path, so a rename looks like mass deletion
plus mass creation — the guard is doing its job, and force tells it to proceed.

Do NOT use force if the deletions surprise you. Investigate instead.

A dry run follows. Check that every "File was deleted" line is an OLD path you
renamed, and every "File is new" line is its replacement.
EOF
    echo
    read -r -p "Press Enter to see the dry run (Ctrl-C to abort) " _ || true
    run_bisync "${COMMON[@]}" --force --dry-run
    echo
    yellow "Above is what WOULD happen. Nothing has changed yet."
    read -r -p "Type FORCE to apply it for real: " reply || true
    [[ "$reply" == "FORCE" ]] || die "Aborted — nothing was changed."
    check_repos
    run_bisync "${COMMON[@]}" --force
    green "Forced sync complete. Normal '42sync' works again from here."
    ;;

  # An excluded file is invisible to sync in BOTH directions, so anything on Drive
  # matching an exclude was uploaded before that rule existed and no future run can
  # ever transfer or remove it. Only reachable by dropping --filter-from and naming
  # the same patterns as --include instead. Deliberately not part of any sync: this
  # deletes, and it should never happen as a side effect of something else.
  orphans)
    SUB="${2:-clean}"
    case "$SUB" in
      check|clean) ;;
      *) die "Usage: 42sync orphans [check]" ;;
    esac
    mapfile -t EXCL < <(grep -E '^- ' "$FILTERS" | sed 's/^- //')
    (( ${#EXCL[@]} )) || die "No exclude rules in $FILTERS — nothing can be orphaned."
    INC=()
    for pat in "${EXCL[@]}"; do INC+=(--include "$pat"); done

    logmsg "=== 42sync orphans $SUB $(date '+%F %T') host=$(uname -n) ==="
    logmsg "remote=$REMOTE filters=$FILTERS"
    logmsg "patterns: ${EXCL[*]}"
    yellow "Exclude patterns, read from $FILTERS:"
    printf '  %s\n' "${EXCL[@]}"
    cat <<'EOF'

Files on Drive matching these were uploaded before the rule existed. No sync sees
them, so nothing will ever move or remove them. That is what makes them orphans.

Read the list below. These patterns are whatever your filter file says TODAY — if
you added a broad exclude recently, its files on Drive appear here too, and those
may be files you still want.
EOF
    echo
    listing="$(mktemp)"
    # stderr is deliberately NOT redirected. rclone writes the config password
    # prompt to stderr, and sending it to the log turns "asking you something"
    # into "hung for no reason" — with stdout already going to $listing there
    # would be nothing on screen at all. Same trap as the one fixed in 'status'.
    rclone ls "$REMOTE" "${INC[@]}" >"$listing" || {
      rm -f "$listing"; die "Could not list $REMOTE."; }
    n=$(wc -l < "$listing")
    if (( n == 0 )); then
      rm -f "$listing"; logmsg "RESULT: none found"
      green "No orphans on Drive — nothing to clean up."
      exit 0
    fi
    bytes=$(awk '{s+=$1} END{print s+0}' "$listing")
    yellow "$n file(s), $(numfmt --to=iec "$bytes" 2>/dev/null || echo "$bytes B") on Drive:"
    head -40 "$listing" | sed 's/^/  /'
    if (( n > 40 )); then echo "  ... and $((n - 40)) more — full list in the log"; fi
    { echo "--- orphans found ---"; cat "$listing"; } >> "$LOG"
    rm -f "$listing"

    if [[ "$SUB" == check ]]; then
      logmsg "RESULT: listed only — nothing was deleted"
        echo
      green "Read-only — nothing was deleted."
      echo "To remove them:  42sync orphans"
      exit 0
    fi

    echo
    read -r -p "Press Enter to see the delete dry run (Ctrl-C to abort) " _ || true
    rclone delete "$REMOTE" "${INC[@]}" --dry-run --verbose 2>&1 | tee -a "$LOG"
    echo
    yellow "Nothing has been deleted yet."
    read -r -p "Type DELETE to remove them from Drive: " reply || true
    if [[ "$reply" != "DELETE" ]]; then
      logmsg "RESULT: aborted at the confirmation prompt — nothing was deleted"
        die "Aborted — nothing was changed."
    fi
    logmsg "confirmed by user — deleting $n file(s)"

    rclone delete "$REMOTE" "${INC[@]}" --verbose 2>&1 | tee -a "$LOG"
    rc=${PIPESTATUS[0]}
    (( rc == 0 )) || { logmsg "RESULT: delete failed (rc=$rc)"; die "Delete failed."; }
    logmsg "RESULT: deleted $n file(s), $bytes bytes — recoverable from Drive trash"

    echo
    yellow "Removing directories left empty ..."
    echo "Errors here are expected and harmless: under the drive.file scope rclone"
    echo "cannot remove a folder that holds anything it did not create."
    rclone rmdirs "$REMOTE" --leave-root --verbose 2>&1 | tee -a "$LOG" || true

    echo
    green "Done. Deleted files sit in Drive's trash for about 30 days."
    echo "bisync is unaffected — these files were never in its listings."
    ;;

  # Choosing what this machine carries, one top-level folder under $LOCAL at a
  # time. That is the only granularity offered on purpose: a rule is anchored to
  # the sync root, so a deeper path is easy to get wrong and fails silently when
  # you do.
  #
  # An exclusion is not a deletion and not a filter on Drive. The remote copy is
  # simply never looked at, so another machine keeps syncing it normally.
  # Verified both ways: excluding leaves the Drive copy frozen and intact,
  # re-including pulls it back with no conflict and no --resync.
  projects)
    SUB="${2:-list}"
    TARGET="${3:-}"

    rule_for()  { printf -- '- /%s/**' "$1"; }
    excluded_names() { grep -E '^- /' "$LOCAL_FILTERS" 2>/dev/null | sed 's|^- /||; s|/\*\*$||' | sort -u; }
    # A bash glob, not `find -printf '%f\n'`: -printf is a GNU findutils
    # extension that BSD find (macOS) rejects, which made this list silently
    # empty on macOS instead of erroring.
    local_names()    { local d; for d in "$LOCAL"/*/; do [[ -d "$d" ]] || continue; d="${d%/}"; printf '%s\n' "${d##*/}"; done | sort; }
    # Artifact filters only, never $LOCAL_FILTERS: the whole point is to show
    # what you are choosing NOT to take. stderr is left alone so rclone's config
    # password prompt reaches the terminal instead of vanishing.
    drive_names()    { rclone lsd "$REMOTE" --filter-from "$FILTERS" | awk '{print $NF}' | sort; }
    # BSD stat (macOS) and GNU stat (Linux, and Windows via Git Bash's MSYS
    # coreutils) take different flags for this. Try GNU's -c FIRST, not BSD's
    # -f: true BSD/macOS stat has no -c at all and fails cleanly (empty stdout),
    # which is what the fallback below relies on. Doing it the other way round
    # breaks on any GNU stat (Linux included, not just Windows) because -c there
    # means "custom format" but -f means "filesystem info, not file info" — it
    # does not reject an unrecognized file-format string, it just ignores it and
    # dumps filesystem stats (blocks/inodes) instead, exiting non-zero but still
    # printing to stdout. That non-empty garbage defeats the `[[ -n "$line" ]]`
    # fallback check, and the leading token of a line like "Inodes: Total: ..."
    # then gets fed to `date` as an "epoch", which is what produced
    # `date: invalid date '@Inodes:'` here.
    newest_local_file() {  # dir -> "YYYY-MM-DD HH:MM  relative/path" of the newest file, empty if none
      local dir="$1" line epoch path
      line="$(find "$dir" -type f -exec stat -c '%Y %n' {} \; 2>/dev/null | sort -rn | head -1)"
      [[ -n "$line" ]] || line="$(find "$dir" -type f -exec stat -f '%m %N' {} \; 2>/dev/null | sort -rn | head -1)"
      [[ -n "$line" ]] || return 0
      epoch="${line%% *}"; path="${line#* }"
      printf '%s  %s\n' \
        "$(date -r "$epoch" '+%Y-%m-%d %H:%M' 2>/dev/null || date -d "@$epoch" '+%Y-%m-%d %H:%M')" \
        "${path#"$dir"/}"
    }

    want_name() {  # a single top-level folder name
      local t="${1#/}"; t="${t%/}"
      [[ -n "$t" ]]      || die "Which folder? Try: 42sync projects"
      [[ "$t" != */* ]]  || die "Only top-level folders under $LOCAL are managed here.
Got '$1'. Use just the folder name, e.g. '${t%%/*}'."
      printf '%s' "$t"
    }

    case "$SUB" in
      list)
        excl="$(excluded_names)"; loc="$(local_names)"; drv="$(drive_names)"
        echo
        printf '  %-9s %-24s %-16s %s\n' STATUS FOLDER WHERE ''
        while IFS= read -r name; do
          [[ -n "$name" ]] || continue
          here=0; there=0
          grep -qxF -- "$name" <<<"$loc" && here=1
          grep -qxF -- "$name" <<<"$drv" && there=1
          where="local + Drive"; (( here )) || where="Drive only"; (( there )) || where="local only"
          if grep -qxF -- "$name" <<<"$excl"; then
            if (( here == 0 && there == 0 )); then
              printf '  \033[33m%-9s\033[0m %-24s %-16s %s\n' stale "$name" "-" "rule matches nothing; drop it"
            elif (( here && there )); then
              printf '  \033[33m%-9s\033[0m %-24s %-16s %s\n' excluded "$name" "$where" "both copies exist -> projects diff $name"
            else
              printf '  \033[33m%-9s\033[0m %-24s %-16s\n' excluded "$name" "$where"
            fi
          else
            printf '  \033[32m%-9s\033[0m %-24s %-16s\n' synced "$name" "$where"
          fi
        done < <(printf '%s\n%s\n%s\n' "$loc" "$drv" "$excl" | grep -v '^$' | sort -u)
        cat <<EOF

  42sync projects include <folder>   carry it on this machine (alias: add)
  42sync projects exclude <folder>   stop carrying it here; Drive copy untouched
  42sync projects diff    <folder>   compare the two copies before you decide
  42sync projects delete  <folder>   remove it from Drive, for every machine
EOF
        logmsg "RESULT: listed"
        ;;

      diff)
        t="$(want_name "$TARGET")"
        [[ -d "$LOCAL/$t" ]] || die "Not on this machine: $LOCAL/$t
Nothing to compare — a plain 'include' will just pull it down from Drive."
        yellow "Comparing  $LOCAL/$t   <->   $REMOTE/$t"
        echo "Reading both sides in full; this takes a moment and changes nothing."
        echo
        cmb="$(mktemp)"
        # Artifact filters only, so an excluded folder is still comparable.
        rclone check "$LOCAL/$t" "$REMOTE/$t" \
          --filter-from "$FILTERS" --links --combined "$cmb" || true
        same=$(grep -c '^= ' "$cmb" || true)
        onlyl=$(grep -c '^- ' "$cmb" || true)
        onlyr=$(grep -c '^+ ' "$cmb" || true)
        diffr=$(grep -c '^\* ' "$cmb" || true)
        printf '  %-22s %s\n' "identical"            "$same"
        printf '  %-22s %s\n' "only on this machine" "$onlyl"
        printf '  %-22s %s\n' "only on Drive"        "$onlyr"
        printf '  %-22s %s\n' "differ"               "$diffr"
        { echo "--- combined report ---"; cat "$cmb"; } >> "$LOG"
        show() { local m="$1" label="$2" n
                 n=$(grep -c "^$m " "$cmb" || true); (( n )) || return 0
                 echo; echo "  $label:"; grep "^$m " "$cmb" | sed "s/^$m /    /" | head -15
                 (( n > 15 )) && echo "    ... and $((n-15)) more — full list in the log"; return 0; }
        show '-' "only on this machine"; show '+' "only on Drive"; show '\*' "differ"
        rm -f "$cmb"
        echo
        newest_local="$(newest_local_file "$LOCAL/$t")"
        newest_drive="$(rclone lsl "$REMOTE/$t" --filter-from "$FILTERS" | sort -k2,3r | head -1 | awk '{print $2" "substr($3,1,5)"  "$4}')"
        printf '  %-22s %s\n' "newest here"     "${newest_local:-none}"
        printf '  %-22s %s\n' "newest on Drive" "${newest_drive:-none}"
        echo
        if (( onlyl == 0 && diffr == 0 && onlyr == 0 )); then
          green "Identical. Safe to include — nothing will move."
        elif (( onlyl == 0 && diffr == 0 )); then
          green "Drive is ahead; this machine has nothing the other side lacks."
          echo "Including it will simply pull the newer files down."
        elif (( onlyr == 0 && diffr == 0 )); then
          green "This machine is ahead; Drive has nothing this side lacks."
          echo "Including it will simply push your files up."
        else
          yellow "Both sides have changes the other does not."
          cat <<EOF

Including it makes bisync do a genuine two-way merge: a file changed on only
one side moves across, but a file changed on BOTH becomes a .conflict pair for
you to resolve by hand. That is safe — nothing is lost — just untidy.

To pick a winner first instead, one of these, with --dry-run until the list
looks right:

  take Drive's copy :  rclone sync "$REMOTE/$t" "$LOCAL/$t" --filter-from "$FILTERS" --links --dry-run
  take this copy    :  rclone sync "$LOCAL/$t" "$REMOTE/$t" --filter-from "$FILTERS" --links --dry-run

'rclone sync' is one-way and deletes on the destination whatever the source
lacks. Read the dry run carefully before dropping the flag.
EOF
        fi
        echo
        echo "Then:  42sync projects include $t"
        logmsg "RESULT: diff same=$same onlyLocal=$onlyl onlyDrive=$onlyr differ=$diffr"
        ;;

      include|add)
        t="$(want_name "$TARGET")"
        rule="$(rule_for "$t")"
        if grep -qxF -- "$rule" "$LOCAL_FILTERS" 2>/dev/null; then
          tmpf="$(mktemp)"
          grep -vxF -- "$rule" "$LOCAL_FILTERS" > "$tmpf" && mv "$tmpf" "$LOCAL_FILTERS"
          logmsg "included: $t"
          green "Now syncing on this machine: $t"
          if [[ -d "$LOCAL/$t" ]]; then
            echo
            yellow "A copy already exists here. If it has drifted from Drive, bisync will"
            echo "produce .conflict pairs rather than pick a side. Worth checking first:"
            echo "  42sync projects diff $t"
          else
            echo "The next sync pulls it down from Drive."
          fi
        else
          green "$t was already syncing — nothing to do."
        fi
        echo
        echo "Check before you sync:  42sync check"
        ;;

      exclude)
        t="$(want_name "$TARGET")"
        # Catch the silent-no-op: a name that exists on neither side is almost
        # always a typo or a path given at the wrong level.
        if ! grep -qxF -- "$t" <<<"$(local_names)" && ! grep -qxF -- "$t" <<<"$(drive_names)"; then
          die "No top-level folder '$t' on this machine or on Drive.
A rule for it would match nothing. Run '42sync projects' to see the real names."
        fi
        rule="$(rule_for "$t")"
        if grep -qxF -- "$rule" "$LOCAL_FILTERS" 2>/dev/null; then
          green "Already excluded on this machine: $t"
        else
          printf '%s\n' "$rule" >> "$LOCAL_FILTERS"
          logmsg "excluded: $t"
          green "No longer syncing on this machine: $t"
        fi
        echo
        echo "The Drive copy is untouched — not transferred, not deleted — so any other"
        echo "machine keeps syncing it normally."
        if [[ -d "$LOCAL/$t" ]]; then
          echo
          yellow "$LOCAL/$t still exists here and will simply stop syncing."
          echo "To reclaim the space:  rm -rf \"$LOCAL/$t\""
          echo "That deletion will NOT reach Drive — the path is filtered out now."
        fi
        echo
        echo "Check before you sync:  42sync check"
        ;;

      delete)
        t="$(want_name "$TARGET")"

        # The dangerous case, and the reason this is a wrapper rather than a note
        # in the README: if the folder is still SYNCED and still here, removing it
        # from Drive makes the next bisync read that as "deleted on Path2" and
        # delete your local copy too. Excluding it first is what protects it.
        if [[ -d "$LOCAL/$t" ]] && ! grep -qxF -- "$(rule_for "$t")" "$LOCAL_FILTERS" 2>/dev/null; then
          die "'$t' is still syncing on this machine, and a copy is here:
  $LOCAL/$t

Deleting it from Drive now would make the next '42sync' see it as deleted and
remove your local copy as well. Stop syncing it here first:

  42sync projects exclude $t
  42sync projects delete  $t

After that the local copy is safe: the path is filtered out, so nothing
propagates in either direction."
        fi

        yellow "About to delete from Drive:  $REMOTE/$t"
        echo
        # No filters anywhere in this branch. Filters are what HIDE these files;
        # purge addresses the path directly, which is why this works at all.
        rclone size "$REMOTE/$t" | sed 's/^/  /'
        echo
        cat <<EOF
This removes the folder for EVERY machine, not just this one. Any other machine
syncing it sees the removal on its next run and deletes its own copy.

Drive keeps deleted files in its trash for about 30 days.
EOF
        if [[ -d "$LOCAL/$t" ]]; then
          echo
          green "Your local copy at $LOCAL/$t is NOT touched by this,"
          echo "and stays safe as long as '$t' remains excluded here."
        fi
        echo
        read -r -p "Press Enter to see the dry run (Ctrl-C to abort) " _ || true
        rclone purge "$REMOTE/$t" --dry-run --verbose 2>&1 | tee -a "$LOG"
        echo
        yellow "Nothing has been deleted yet."
        read -r -p "Type the folder name '$t' to delete it from Drive: " reply || true
        if [[ "$reply" != "$t" ]]; then
          logmsg "RESULT: aborted at the confirmation prompt — nothing was deleted"
          die "Aborted — nothing was changed."
        fi
        logmsg "confirmed by user — purging $REMOTE/$t"

        rclone purge "$REMOTE/$t" --verbose 2>&1 | tee -a "$LOG"
        rc=${PIPESTATUS[0]}
        if (( rc != 0 )); then
          logmsg "RESULT: purge failed (rc=$rc)"
          red "Purge did not complete."
          cat <<'EOF'

If the log shows 'appNotAuthorizedToChild', that folder holds something rclone
did not create — most likely a file added through drive.google.com. Under the
drive.file scope no rclone command can remove it. Whatever is left has to go
through the Drive web interface.
EOF
          exit "$rc"
        fi
        logmsg "RESULT: purged $REMOTE/$t"
        green "Deleted from Drive: $t"
        if [[ -d "$LOCAL/$t" ]]; then
          echo
          echo "The exclusion rule is deliberately left in place. It is now the only"
          echo "thing stopping the next sync from uploading your local copy straight"
          echo "back to Drive. Remove the local folder too if you are done with it:"
          echo "  rm -rf \"$LOCAL/$t\""
        fi
        ;;

      *) die "Usage: 42sync projects [list|include <folder>|exclude <folder>|diff <folder>|delete <folder>]" ;;
    esac
    ;;

  status)
    echo "Local:  $LOCAL"
    du -sh "$LOCAL" 2>/dev/null || echo "  (does not exist yet — run: 42sync seed)"
    [[ -f "$LOCAL/RCLONE_TEST" ]] && green "  access marker present" || yellow "  access marker MISSING"
    echo
    echo "Remote: $REMOTE"
    rclone size "$REMOTE" "${FILTER_ARGS[@]}" || true
    echo
    echo "Baseline: $WORKDIR"
    if ls "$WORKDIR"/*.lst >/dev/null 2>&1; then
      green "  present ($(ls -1 "$WORKDIR"/*.lst 2>/dev/null | wc -l) listing files)"
    else
      yellow "  MISSING — next run needs --resync"
    fi
    echo
    echo "Recent runs:"
    recent="$(ls -1t "$LOGDIR"/*.log 2>/dev/null | grep -v '/last\.log$' | head -5)"
    if [[ -n "$recent" ]]; then
      printf '%s\n' "$recent" | sed 's|^|  |'
    else
      echo "  (none)"
    fi
    ;;

  logs)
    ls -1t "$LOGDIR"/*.log 2>/dev/null | grep -v '/last\.log$' || echo "(no logs yet)"
    ;;

  sync)
    require_local
    warn_no_multiplexer
    check_repos
    run_bisync "${COMMON[@]}"
    green "Synced."
    ;;

  *)
    die "unreachable: mode was validated at startup"
    ;;
esac
