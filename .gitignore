# ---- rclone credentials: NEVER commit these ----
rclone.conf
*.conf
# *.conf is deliberately broad. To commit an example config anyway:
#   git add -f rclone.conf.example
.rclone/
rclone-*.json

# Google OAuth client files downloaded from Cloud Console
client_secret*.json
*credentials*.json
*token*.json

# ---- private key material: NEVER commit these ----
# The 2026-05 leak was .ssh/id_rsa, committed by an unfiltered `git add .` run in
# a folder that also held dotfiles. Note that *.key and *.pem below do NOT match
# an extensionless SSH key, which is why these rules exist separately.
.ssh/
id_rsa
id_dsa
id_ecdsa
id_ed25519
*_rsa
*_ed25519
*.ppk

# GPG private key material. Deliberately NOT a blanket *.asc rule:
# scripts/rclone-release-key.asc is a PUBLIC key and is committed on purpose.
.gnupg/
secring.*
*.gpg
*private*.asc

# ---- rclone install artifacts, if you ever unpack one inside the repo ----
/rclone
rclone-v*/
rclone-v*.zip
rclone-current-*.zip
SHA256SUMS

# ---- environment / secrets ----
.env
.env.*
secrets/
*.key
*.pem

# ---- logs and temp ----
*.log
*.tmp
bisync-state/

# ---- OS and editor junk ----
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
.claude/settings.local.json
